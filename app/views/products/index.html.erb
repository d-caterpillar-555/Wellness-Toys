<% heading = @category&.name.presence || @brand&.name.presence || "The catalogue" %>
<% filtered = @category || @brand %>
<% content_for :title, heading %>
<% content_for :meta_description, filtered ? "Everything #{Store.name} stocks, filtered to #{heading}." : "Everything #{Store.name} stocks." %>

<section class="wt-container pt-12 pb-8 md:pt-16" data-controller="reveal" data-reveal>
  <nav aria-label="Breadcrumb" class="text-caption">
    <% if @category %>
      <%= link_to "Shop", shop_path, class: "text-body no-underline hover:text-ink" %>
      <span aria-hidden="true" class="text-muted"> / </span>
      <span class="text-ink" aria-current="page"><%= @category.name %></span>
    <% else %>
      <span class="text-ink">Shop</span>
    <% end %>
  </nav>

  <h1 class="mt-4 text-display-sm text-ink md:text-display"><%= heading %></h1>
  <p class="mt-3 text-ui text-muted tnum"><%= pluralize(@pagy.count, "product") %></p>
</section>

<section class="wt-container pb-10">
  <%= form_with url: shop_path, method: :get, class: "flex flex-wrap items-end gap-3" do |form| %>
    <% if @category %><%= form.hidden_field :category, value: @category.slug %><% end %>

    <div class="min-w-[16rem]">
      <%= form.label :brand, "Brand", class: "wt-label" %>
      <%= form.select :brand,
            options_for_select(@brands.map { |brand| [ brand.name, brand.slug ] }, @brand&.slug),
            { include_blank: "All brands" },
            class: "wt-input" %>
    </div>

    <%= form.submit "Apply", class: "wt-btn wt-btn--secondary" %>
    <%= link_to "Clear", shop_path, class: "wt-btn wt-btn--quiet" if @brand || @category %>
  <% end %>
</section>

<section class="wt-container pb-20" data-controller="reveal" data-reveal>
  <h2 class="sr-only">Products</h2>

  <% if @products.any? %>
    <div class="wt-catalogue__grid">
      <% @products.each do |product| %>
        <%= render "products/card", product: product %>
      <% end %>
    </div>
    <%= render "shared/pagination", pagy: @pagy %>
  <% elsif @brand || @category %>
    <div class="max-w-[52ch] border-t border-line pt-8">
      <p class="text-lede text-ink">Nothing matches this filter yet.</p>
      <p class="mt-3 text-body">Either the range is narrower than the catalogue, or nothing we stock fits it. Both are worth knowing.</p>
      <%= link_to "Show every product", shop_path, class: "wt-btn wt-btn--secondary mt-6" %>
    </div>
  <% else %>
    <div class="max-w-[52ch] border-t border-line pt-8">
      <p class="text-lede text-ink">The catalogue is empty right now.</p>
      <p class="mt-3 text-body">We are between deliveries. The standards we hold a product to are published in the meantime.</p>
      <%= link_to "Read our standards", page_path("standards"), class: "wt-btn wt-btn--secondary mt-6" %>
    </div>
  <% end %>
</section>
