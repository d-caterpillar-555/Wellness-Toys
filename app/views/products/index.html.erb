<% content_for :title, "The catalogue" %>
<% content_for :meta_description, "Every object #{Store.name} stocks, kept as a register: departments, materials, and prices as data." %>

<div class="inst">
  <header class="inst-run">
    <p class="inst-run__mark"><%= link_to Store.name, root_path, class: "inst-link" %></p>
    <p class="inst-run__section">The catalogue</p>
    <p><%= pluralize(@pagy.count, "object") %></p>
  </header>

  <div class="inst-body">
    <nav class="inst-rail" aria-label="Contents" data-institute-rail>
      <p class="inst-rail__title">Contents</p>
      <ol class="inst-rail__list">
        <li><a class="inst-rail__link" href="#catalogue"><span class="inst-rail__number">1</span>The register</a></li>
        <% if @brands.any? %>
          <li><a class="inst-rail__link" href="#makers"><span class="inst-rail__number">2</span>The makers</a></li>
        <% end %>
      </ol>
    </nav>

    <article class="inst-sheet inst-sheet--wide">
      <section class="inst-clause" id="catalogue" data-institute-clause>
        <div class="inst-clause__head">
          <p class="inst-clause__number">1</p>
          <h1 class="inst-clause__title">The register</h1>
        </div>
        <p class="inst-clause__standfirst">
          Every object the shop keeps, in the order it was entered. A department filters the
          register; nothing is hidden behind a promotion.
        </p>

        <nav class="inst-facets" aria-label="Departments">
          <%= link_to "All", shop_path, class: "inst-facet",
                aria: { current: ("page" if @category.nil? && @brand.nil?) } %>
          <% @register.each do |category| %>
            <%= link_to category.name, category_path(category), class: "inst-facet",
                  aria: { current: ("page" if @category == category) } %>
          <% end %>
        </nav>

        <% if @products.any? %>
          <ol class="inst-ledger">
            <% @products.each do |product| %>
              <% row = capture do %>
                <span class="inst-ledger__plate"><%= product_cover_tag(product) %></span>
                <span>
                  <span class="inst-ledger__name"><%= product.name %></span>
                  <span class="inst-ledger__meta">
                    <%= product.primary_category&.name || "Catalogue" %>
                    <% if product.brand %> &middot; <%= product.brand.name %><% end %>
                    <% unless product.in_stock? %> &middot; Out of stock<% end %>
                  </span>
                </span>
                <span class="inst-ledger__price"><%= price(product.lowest_price_cents) %></span>
              <% end %>

              <li>
                <% if product.primary_category %>
                  <%= link_to product_path(product.primary_category, product), class: "inst-ledger__row" do %>
                    <%= row %>
                  <% end %>
                <% else %>
                  <div class="inst-ledger__row inst-ledger__row--plain"><%= row %></div>
                <% end %>
              </li>
            <% end %>
          </ol>

          <%= render "shared/pagination", pagy: @pagy %>
        <% else %>
          <p class="inst-standing">
            <%= (@category || @brand) ? "Nothing matches this filter yet." : "The catalogue is empty right now." %>
            An empty shelf is a fact; we would rather show it than fill it.
          </p>
        <% end %>
      </section>

      <% if @brands.any? %>
        <section class="inst-clause" id="makers" data-institute-clause>
          <div class="inst-clause__head">
            <p class="inst-clause__number">2</p>
            <h2 class="inst-clause__title">The makers</h2>
          </div>
          <p class="inst-clause__standfirst">
            Every maker we stock, and how many of their objects are in the register today.
          </p>
          <ol class="inst-register">
            <% @brands.each do |brand| %>
              <li>
                <%= link_to shop_path(brand: brand.slug), class: "inst-register__row" do %>
                  <span class="inst-register__name"><%= brand.name %></span>
                  <span class="inst-register__count"><%= pluralize(brand.product_count, "object") %></span>
                <% end %>
              </li>
            <% end %>
          </ol>
        </section>
      <% end %>
    </article>
  </div>
</div>
