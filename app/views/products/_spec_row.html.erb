<%# locals: (label:, value:) %>
<%# One specification, printed as a register row: label, dot leader, value. The
    value is data, so it is set in the display face with tabular numerals. %>
<div class="flex items-baseline gap-3 border-t border-line py-3">
  <dt class="wt-register shrink-0"><%= label %></dt>
  <span class="wt-leader" aria-hidden="true"></span>
  <dd class="text-ui text-ink tnum text-right"><%= value %></dd>
</div>
