<% meta_description = @product.subtitle.presence || [ @product.name, ("by #{@product.brand.name}" if @product.brand) ].compact.join(" ") %>
<% content_for :title, @product.name %>
<% content_for :og_type, "product" %>
<% content_for :meta_description, meta_description %>

<% trail = [ [ "Shop", shop_path ] ] %>
<% trail << [ @primary_category.name, category_path(@primary_category) ] if @primary_category %>
<% trail << [ @product.name, request.path ] %>

<% content_for :structured_data do %>
  <%= json_ld(breadcrumb_schema(trail)) %>
  <%= json_ld(product_schema(@product, variants: @variants, category: @primary_category)) %>
<% end %>

<%# The contents rail is built from the sections this product actually has, so
    a sparse record does not advertise sections it cannot fill. %>
<% contents = [] %>
<% contents << [ "specifications", "Materials and safety" ] if @product.materials.present? || @product.safety_notes.present? || @product.weight_grams.present? %>
<% contents << [ "how", "How it works" ] if @product.description.present? %>
<% contents << [ "care", "Care" ] if @product.care_instructions.present? %>
<% contents << [ "dimensions", "Dimensions" ] if @product.dimensions.present? || @product.weight_grams.present? %>
<% contents << [ "reviews", "Reviews" ] %>
<% contents << [ "questions", "Questions" ] if @faqs.any? %>

<article class="wt-container pt-8 pb-24 md:pt-12" data-controller="register">
  <nav aria-label="Breadcrumb" class="text-caption">
    <%= link_to "Shop", shop_path, class: "text-body no-underline hover:text-ink" %>
    <% if @primary_category %>
      <span aria-hidden="true" class="text-muted"> / </span>
      <%= link_to @primary_category.name, category_path(@primary_category), class: "text-body no-underline hover:text-ink" %>
    <% end %>
    <span aria-hidden="true" class="text-muted"> / </span>
    <span class="text-ink" aria-current="page"><%= @product.name %></span>
  </nav>

  <%# --- The plate ---------------------------------------------------------
      Image on the left, the record on the right. The register line above the
      title carries the real identifiers: brand and SKU. %>
  <div class="mt-8 grid gap-12 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,1fr)] lg:gap-16">
    <div data-controller="reveal" data-reveal>
      <div class="wt-specimen aspect-square">
        <%= product_cover_tag(@product) %>
        <span class="wt-specimen__stamp wt-register"><%= @product.sku %></span>
      </div>
    </div>

    <div data-controller="reveal" data-reveal>
      <p class="wt-register">
        <% if @product.brand %><%= @product.brand.name %> · <% end %><%= @product.sku %>
      </p>
      <h1 class="mt-3 text-heading-lg text-ink md:text-display-sm"><%= @product.name %></h1>

      <% if @product.subtitle.present? %>
        <p class="mt-4 max-w-[46ch] text-lede text-body"><%= @product.subtitle %></p>
      <% end %>

      <p class="wt-numeral mt-6 text-heading"><%= price(@product.lowest_price_cents) %></p>

      <div class="mt-8">
        <% if @variants.any? %>
          <%= form_with url: cart_items_path, method: :post, class: "space-y-6" do |form| %>
            <fieldset>
              <legend class="wt-register mb-2"><%= t("products.configuration") %></legend>
              <div>
                <% @variants.each_with_index do |variant, index| %>
                  <label class="wt-choice-row">
                    <span class="flex items-center gap-3">
                      <%= radio_button_tag "variant_id", variant.id, index.zero?, id: "variant_#{variant.id}", class: "wt-choice" %>
                      <span class="text-ui text-ink"><%= variant.name %></span>
                    </span>
                    <span class="flex items-center gap-3">
                      <%= stock_label(variant) %>
                      <span class="wt-numeral text-ui"><%= price(variant.price_cents, currency: variant.currency) %></span>
                    </span>
                  </label>
                <% end %>
                <div class="border-t border-line"></div>
              </div>
            </fieldset>

            <div class="max-w-[12rem]">
              <label class="wt-label" for="quantity"><%= t("cart.quantity") %></label>
              <%= form.select :quantity, quantity_options, {}, class: "wt-input", id: "quantity" %>
            </div>

            <%= form.submit t("products.add_to_cart"), class: "wt-btn wt-btn--primary w-full" %>
          <% end %>
        <% else %>
          <p class="wt-plate wt-plate--sunk px-5 py-4 text-ui text-ink">No configuration of this product is available right now.</p>
        <% end %>
      </div>
    </div>
  </div>

  <%# --- The monograph ----------------------------------------------------
      Contents rail on the left, the record on the right. The rail is the same
      instrument the education library uses for its evidence. %>
  <div class="mt-20 grid gap-16 lg:grid-cols-[14rem_minmax(0,1fr)] lg:gap-20">
    <nav class="wt-rail" aria-label="Contents">
      <p class="wt-register mb-2">Contents</p>
      <ul>
        <% contents.each do |id, label| %>
          <li>
            <a href="#<%= id %>" class="wt-rail__link" data-register-target="link"><%= label %></a>
          </li>
        <% end %>
      </ul>
    </nav>

    <div class="space-y-16">
      <section id="specifications" aria-labelledby="specifications-heading" data-register-target="section">
        <h2 id="specifications-heading" class="text-heading text-ink">Materials and safety</h2>

        <% has_specs = @product.materials.present? || @product.safety_notes.present? %>
        <% if has_specs %>
          <dl class="mt-6">
            <% if @product.materials.present? %>
              <%= render "products/spec_row", label: "Materials", value: @product.materials %>
            <% end %>
            <%= render "products/spec_row", label: "Body safe", value: @product.body_safe? ? "Yes" : "No" %>
            <% if @product.safety_notes.present? %>
              <%= render "products/spec_row", label: "Safety notes", value: @product.safety_notes %>
            <% end %>
          </dl>
        <% else %>
          <p class="mt-6 max-w-[60ch] text-body">Specifications for this product have not been recorded yet. We would rather leave the field empty than fill it with something we cannot stand behind.</p>
        <% end %>
      </section>

      <% if @product.description.present? %>
        <section id="how" aria-labelledby="how-heading" data-register-target="section" data-controller="reveal" data-reveal>
          <h2 id="how-heading" class="text-heading text-ink">How it works</h2>
          <div class="wt-prose mt-6"><p><%= @product.description %></p></div>
        </section>
      <% end %>

      <% if @product.care_instructions.present? %>
        <section id="care" aria-labelledby="care-heading" data-register-target="section">
          <h2 id="care-heading" class="text-heading text-ink">Care</h2>
          <div class="wt-prose mt-6"><p><%= @product.care_instructions %></p></div>
        </section>
      <% end %>

      <% if @product.dimensions.present? || @product.weight_grams.present? %>
        <section id="dimensions" aria-labelledby="dimensions-heading" data-register-target="section">
          <h2 id="dimensions-heading" class="text-heading text-ink">Dimensions</h2>
          <dl class="mt-6">
            <% if @product.dimensions.present? %>
              <%= render "products/spec_row", label: "Dimensions", value: @product.dimensions %>
            <% end %>
            <% if @product.weight_grams.present? %>
              <%= render "products/spec_row", label: "Weight", value: "#{@product.weight_grams} g" %>
            <% end %>
          </dl>
        </section>
      <% end %>

      <section id="reviews" aria-labelledby="reviews-heading" data-register-target="section">
        <h2 id="reviews-heading" class="text-heading text-ink">Reviews</h2>

        <% if @reviews.any? %>
          <ul class="mt-6">
            <% @reviews.each do |review| %>
              <li class="border-t border-line pt-6 pb-2">
                <div class="flex flex-wrap items-center gap-3">
                  <p class="text-ui text-ink"><span class="tnum"><%= review.rating %></span> out of 5</p>
                  <%= tag.span("Verified purchase", class: "wt-mark wt-mark--accent") if review.verified_purchase? %>
                </div>
                <% if review.title.present? %>
                  <h3 class="mt-3 text-title text-ink"><%= review.title %></h3>
                <% end %>
                <% if review.body.present? %>
                  <p class="mt-2 max-w-[68ch] text-body"><%= review.body %></p>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <div class="mt-6 max-w-[52ch] border-t border-line pt-6">
            <p class="text-lede text-ink">No reviews here yet.</p>
            <p class="mt-3 text-body">Reviews open once ordering and accounts are live. Nothing is invented to fill this space in the meantime.</p>
            <%= link_to "Ask us a question", page_path("contact"), class: "wt-btn wt-btn--quiet mt-4" %>
          </div>
        <% end %>
      </section>

      <% if @faqs.any? %>
        <section id="questions" aria-labelledby="questions-heading" data-register-target="section">
          <h2 id="questions-heading" class="text-heading text-ink">Questions</h2>
          <div class="mt-6">
            <% @faqs.each do |faq| %>
              <details class="border-t border-line">
                <summary class="flex min-h-[44px] cursor-pointer items-center text-ui text-ink"><%= faq.question %></summary>
                <p class="mt-3 max-w-[68ch] pb-4 text-body"><%= faq.answer %></p>
              </details>
            <% end %>
            <div class="border-t border-line"></div>
          </div>
        </section>
      <% end %>

      <aside class="wt-plate wt-plate--sunk p-6">
        <h2 class="text-title text-ink">Education</h2>
        <p class="mt-3 max-w-[52ch] text-ui text-body">Materials, safety and use, explained without a sales pitch. The library carries the sources.</p>
        <%= link_to "Read the library", learn_path, class: "wt-btn wt-btn--secondary mt-5" %>
      </aside>
    </div>
  </div>
</article>
