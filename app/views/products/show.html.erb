<% meta_description = @product.subtitle.presence || [ @product.name, ("by #{@product.brand.name}" if @product.brand) ].compact.join(" ") %>
<% content_for :title, @product.name %>
<% content_for :og_type, "product" %>
<% content_for :meta_description, meta_description %>

<% trail = [ [ "Shop", shop_path ] ] %>
<% trail << [ @primary_category.name, category_path(@primary_category) ] if @primary_category %>
<% trail << [ @product.name, request.path ] %>

<% content_for :structured_data do %>
  <%= json_ld(breadcrumb_schema(trail)) %>
  <%= json_ld(product_schema(@product, variants: @variants, category: @primary_category)) %>
<% end %>

<article class="wt-container pt-10 pb-24 md:pt-14">
  <nav aria-label="Breadcrumb" class="text-caption">
    <%= link_to "Shop", shop_path, class: "text-body no-underline hover:text-ink" %>
    <% if @primary_category %>
      <span aria-hidden="true" class="text-muted"> / </span>
      <%= link_to @primary_category.name, category_path(@primary_category), class: "text-body no-underline hover:text-ink" %>
    <% end %>
    <span aria-hidden="true" class="text-muted"> / </span>
    <span class="text-ink" aria-current="page"><%= @product.name %></span>
  </nav>

  <div class="mt-8 grid gap-12 lg:grid-cols-2 lg:gap-16">
    <div data-controller="reveal" data-reveal>
      <%= product_cover_tag(@product, size: :detail) %>
    </div>

    <div>
      <% if @product.brand %>
        <p class="text-label text-muted"><%= @product.brand.name %></p>
      <% end %>
      <h1 class="mt-2 text-heading-lg text-ink md:text-display-sm"><%= @product.name %></h1>

      <% if @product.subtitle.present? %>
        <p class="mt-4 max-w-[46ch] text-lede text-body"><%= @product.subtitle %></p>
      <% end %>

      <p class="mt-6 text-heading-sm text-ink"><%= price(@product.lowest_price_cents) %></p>

      <div class="mt-8">
        <% if @variants.any? %>
          <%= form_with url: cart_items_path, method: :post, class: "space-y-4" do |form| %>
            <fieldset>
              <legend class="wt-label"><%= t("products.configuration") %></legend>
              <div class="space-y-2">
                <% @variants.each_with_index do |variant, index| %>
                  <label class="flex min-h-[44px] items-center justify-between gap-4 rounded-lg border border-line px-4 py-3">
                    <span class="flex items-center gap-3">
                      <%= radio_button_tag "variant_id", variant.id, index.zero?, id: "variant_#{variant.id}" %>
                      <span class="text-ui text-ink"><%= variant.name %></span>
                    </span>
                    <span class="flex items-center gap-3">
                      <%= stock_label(variant) %>
                      <span class="text-ui text-ink"><%= price(variant.price_cents, currency: variant.currency) %></span>
                    </span>
                  </label>
                <% end %>
              </div>
            </fieldset>

            <div>
              <label class="wt-label" for="quantity"><%= t("cart.quantity") %></label>
              <%= form.select :quantity, quantity_options, {}, class: "wt-input", id: "quantity" %>
            </div>

            <%= form.submit t("products.add_to_cart"), class: "wt-btn wt-btn--primary w-full" %>
          <% end %>
        <% else %>
          <p class="wt-panel px-5 py-4 text-ui text-ink">No configuration of this product is available right now.</p>
        <% end %>
      </div>
    </div>
  </div>

  <% has_specs = @product.materials.present? || @product.safety_notes.present? || @product.dimensions.present? || @product.weight_grams.present? %>

  <div class="mt-20 grid gap-16 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-20">
    <div class="space-y-16">
      <section aria-labelledby="materials-heading">
        <h2 id="materials-heading" class="text-heading text-ink">Materials and safety</h2>

        <% if has_specs %>
          <dl class="mt-6 border-t border-line text-ui">
            <% if @product.materials.present? %>
              <%= render "products/spec_row", label: "Materials", value: @product.materials %>
            <% end %>
            <%= render "products/spec_row", label: "Body safe", value: @product.body_safe? ? "Yes" : "No" %>
            <% if @product.safety_notes.present? %>
              <%= render "products/spec_row", label: "Safety notes", value: @product.safety_notes %>
            <% end %>
          </dl>
        <% else %>
          <p class="mt-6 max-w-[60ch] text-body">Specifications for this product have not been recorded yet. We would rather leave the field empty than fill it with something we cannot stand behind.</p>
        <% end %>
      </section>

      <% if @product.description.present? %>
        <section aria-labelledby="how-heading" data-controller="reveal" data-reveal>
          <h2 id="how-heading" class="text-heading text-ink">How it works</h2>
          <div class="wt-prose mt-6"><p><%= @product.description %></p></div>
        </section>
      <% end %>

      <% if @product.care_instructions.present? %>
        <section aria-labelledby="care-heading">
          <h2 id="care-heading" class="text-heading text-ink">Care</h2>
          <div class="wt-prose mt-6"><p><%= @product.care_instructions %></p></div>
        </section>
      <% end %>

      <% if @product.dimensions.present? || @product.weight_grams.present? %>
        <section aria-labelledby="dimensions-heading">
          <h2 id="dimensions-heading" class="text-heading text-ink">Dimensions</h2>
          <dl class="mt-6 border-t border-line text-ui">
            <% if @product.dimensions.present? %>
              <%= render "products/spec_row", label: "Dimensions", value: @product.dimensions %>
            <% end %>
            <% if @product.weight_grams.present? %>
              <%= render "products/spec_row", label: "Weight", value: "#{@product.weight_grams} g" %>
            <% end %>
          </dl>
        </section>
      <% end %>

      <section aria-labelledby="reviews-heading">
        <h2 id="reviews-heading" class="text-heading text-ink">Reviews</h2>

        <% if @reviews.any? %>
          <ul class="mt-6">
            <% @reviews.each do |review| %>
              <li class="border-t border-line pt-6 pb-2">
                <div class="flex flex-wrap items-center gap-3">
                  <p class="text-ui text-ink"><span class="tnum"><%= review.rating %></span> out of 5</p>
                  <%= tag.span("Verified purchase", class: "wt-badge wt-badge--accent") if review.verified_purchase? %>
                </div>
                <% if review.title.present? %>
                  <h3 class="mt-3 text-title text-ink"><%= review.title %></h3>
                <% end %>
                <% if review.body.present? %>
                  <p class="mt-2 max-w-[68ch] text-body"><%= review.body %></p>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <div class="mt-6 max-w-[52ch] border-t border-line pt-6">
            <p class="text-lede text-ink">No reviews here yet.</p>
            <p class="mt-3 text-body">Reviews open once ordering and accounts are live. Nothing is invented to fill this space in the meantime.</p>
            <%= link_to "Ask us a question", page_path("contact"), class: "wt-btn wt-btn--quiet mt-4" %>
          </div>
        <% end %>
      </section>

      <% if @faqs.any? %>
        <section aria-labelledby="faqs-heading">
          <h2 id="faqs-heading" class="text-heading text-ink">Questions</h2>
          <div class="mt-6 border-t border-line">
            <% @faqs.each do |faq| %>
              <details class="border-b border-line">
                <summary class="flex min-h-[44px] cursor-pointer items-center text-ui text-ink"><%= faq.question %></summary>
                <p class="mt-3 max-w-[68ch] pb-4 text-body"><%= faq.answer %></p>
              </details>
            <% end %>
          </div>
        </section>
      <% end %>
    </div>

    <aside class="lg:border-l lg:border-line lg:pl-8">
      <div class="wt-panel p-6">
        <h2 class="text-title text-ink">Education</h2>
        <p class="mt-3 text-ui text-body">Materials, safety and use, explained without a sales pitch. The library carries the sources.</p>
        <%= link_to "Read the library", learn_path, class: "wt-btn wt-btn--secondary mt-5" %>
      </div>
    </aside>
  </div>
</article>
