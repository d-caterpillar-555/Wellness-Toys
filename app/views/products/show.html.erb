<% meta_description = @product.subtitle.presence || [ @product.name, ("by #{@product.brand.name}" if @product.brand) ].compact.join(" ") %>
<% content_for :title, @product.name %>
<% content_for :og_type, "product" %>
<% content_for :meta_description, meta_description %>

<% trail = [ [ "Shop", shop_path ] ] %>
<% trail << [ @primary_category.name, category_path(@primary_category) ] if @primary_category %>
<% trail << [ @product.name, request.path ] %>

<% content_for :structured_data do %>
  <%= json_ld(breadcrumb_schema(trail)) %>
  <%= json_ld(product_schema(@product, variants: @variants, category: @primary_category)) %>
<% end %>

<%# The contents rail is built from the sections this record actually has, so a
    sparse object does not advertise sections it cannot fill. %>
<% contents = [] %>
<% contents << [ "specifications", "Materials and safety" ] if @product.materials.present? || @product.safety_notes.present? || @product.weight_grams.present? %>
<% contents << [ "how", "How it works" ] if @product.description.present? %>
<% contents << [ "care", "Care" ] if @product.care_instructions.present? %>
<% contents << [ "dimensions", "Dimensions" ] if @product.dimensions.present? || @product.weight_grams.present? %>
<% contents << [ "reviews", "Reviews" ] %>
<% contents << [ "questions", "Questions" ] if @faqs.any? %>

<div class="inst">
  <header class="inst-run">
    <p class="inst-run__mark"><%= link_to Store.name, root_path, class: "inst-link" %></p>
    <p class="inst-run__section">
      <%= link_to "Catalogue", shop_path, class: "inst-link" %>
      <% if @primary_category %> &middot; <%= link_to @primary_category.name, category_path(@primary_category), class: "inst-link" %><% end %>
    </p>
    <p><%= @product.sku %></p>
  </header>

  <div class="inst-body">
    <nav class="inst-rail" aria-label="Contents" data-institute-rail>
      <p class="inst-rail__title">Contents</p>
      <ol class="inst-rail__list">
        <% contents.each_with_index do |(id, label), index| %>
          <li>
            <a class="inst-rail__link" href="#<%= id %>">
              <span class="inst-rail__number"><%= index + 1 %></span><%= label %>
            </a>
          </li>
        <% end %>
      </ol>
    </nav>

    <article class="inst-sheet inst-sheet--wide">
      <section class="inst-clause" data-institute-clause>
        <div class="inst-record">
          <div>
            <div class="inst-plate"><%= product_cover_tag(@product) %></div>
          </div>

          <div class="inst-record__head">
            <p class="inst-clause__number">
              <% if @product.brand %><%= @product.brand.name %> &middot; <% end %><%= @product.sku %>
            </p>
            <h1 class="inst-record__title"><%= @product.name %></h1>
            <% if @product.subtitle.present? %>
              <p class="inst-clause__standfirst inst-record__sub"><%= @product.subtitle %></p>
            <% end %>

            <p class="inst-price inst-record__price"><%= price(@product.lowest_price_cents) %></p>

            <div class="inst-record__form">
              <% if @variants.any? %>
                <%= form_with url: cart_items_path, method: :post do |form| %>
                  <fieldset class="inst-fieldset">
                    <legend class="inst-quantity__label inst-legend"><%= t("products.configuration") %></legend>
                    <% @variants.each_with_index do |variant, index| %>
                      <label class="inst-choice">
                        <span class="inst-choice__pair">
                          <%= radio_button_tag "variant_id", variant.id, index.zero?, id: "variant_#{variant.id}" %>
                          <span class="inst-choice__name"><%= variant.name %></span>
                        </span>
                        <span class="inst-choice__aside">
                          <%= stock_label(variant) %>
                          <span class="inst-ledger__price"><%= price(variant.price_cents, currency: variant.currency) %></span>
                        </span>
                      </label>
                    <% end %>
                  </fieldset>

                  <div class="inst-quantity">
                    <label class="inst-quantity__label" for="quantity"><%= t("cart.quantity") %></label>
                    <%= form.select :quantity, quantity_options, {}, id: "quantity" %>
                  </div>

                  <%= form.submit t("products.add_to_cart"), class: "inst-button" %>
                <% end %>
              <% else %>
                <p class="inst-note">No configuration of this product is available right now.</p>
              <% end %>
            </div>
          </div>
        </div>
      </section>

      <section class="inst-clause" id="specifications" data-institute-clause>
        <div class="inst-clause__head">
          <p class="inst-clause__number">1</p>
          <h2 class="inst-clause__title">Materials and safety</h2>
        </div>

        <% if @product.materials.present? || @product.safety_notes.present? %>
          <dl class="inst-spec">
            <% if @product.materials.present? %>
              <div class="inst-spec__row">
                <dt class="inst-spec__label">Materials</dt>
                <dd class="inst-spec__value"><%= @product.materials %></dd>
              </div>
            <% end %>
            <div class="inst-spec__row">
              <dt class="inst-spec__label">Body safe</dt>
              <dd class="inst-spec__value"><%= @product.body_safe? ? "Yes" : "No" %></dd>
            </div>
            <% if @product.safety_notes.present? %>
              <div class="inst-spec__row">
                <dt class="inst-spec__label">Safety notes</dt>
                <dd class="inst-spec__value"><%= @product.safety_notes %></dd>
              </div>
            <% end %>
          </dl>
        <% else %>
          <p class="inst-standing">
            Specifications for this object have not been recorded yet. We would rather leave the
            field empty than fill it with something we cannot stand behind.
          </p>
        <% end %>
      </section>

      <% if @product.description.present? %>
        <section class="inst-clause" id="how" data-institute-clause>
          <div class="inst-clause__head">
            <p class="inst-clause__number">2</p>
            <h2 class="inst-clause__title">How it works</h2>
          </div>
          <div class="inst-prose"><p><%= @product.description %></p></div>
        </section>
      <% end %>

      <% if @product.care_instructions.present? %>
        <section class="inst-clause" id="care" data-institute-clause>
          <div class="inst-clause__head">
            <p class="inst-clause__number">3</p>
            <h2 class="inst-clause__title">Care</h2>
          </div>
          <div class="inst-prose"><p><%= @product.care_instructions %></p></div>
        </section>
      <% end %>

      <% if @product.dimensions.present? || @product.weight_grams.present? %>
        <section class="inst-clause" id="dimensions" data-institute-clause>
          <div class="inst-clause__head">
            <p class="inst-clause__number">4</p>
            <h2 class="inst-clause__title">Dimensions</h2>
          </div>
          <dl class="inst-spec">
            <% if @product.dimensions.present? %>
              <div class="inst-spec__row">
                <dt class="inst-spec__label">Dimensions</dt>
                <dd class="inst-spec__value"><%= @product.dimensions %></dd>
              </div>
            <% end %>
            <% if @product.weight_grams.present? %>
              <div class="inst-spec__row">
                <dt class="inst-spec__label">Weight</dt>
                <dd class="inst-spec__value"><%= @product.weight_grams %> g</dd>
              </div>
            <% end %>
          </dl>
        </section>
      <% end %>

      <section class="inst-clause" id="reviews" data-institute-clause>
        <div class="inst-clause__head">
          <p class="inst-clause__number">5</p>
          <h2 class="inst-clause__title">Reviews</h2>
        </div>

        <% if @reviews.any? %>
          <ul class="inst-reading-list">
            <% @reviews.each do |review| %>
              <li class="inst-reading-list__item">
                <p class="inst-reading-list__meta inst-review__meta">
                  <%= review.rating %> out of 5<% if review.verified_purchase? %> &middot; Verified purchase<% end %>
                </p>
                <% if review.title.present? %>
                  <p class="inst-review__title"><%= review.title %></p>
                <% end %>
                <% if review.body.present? %>
                  <div class="inst-prose inst-prose--tight"><p><%= review.body %></p></div>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="inst-standing">No reviews here yet. Reviews open once ordering and accounts are live, and nothing is invented to fill this space in the meantime.</p>
          <div class="inst-actions">
            <%= link_to "Ask us a question", page_path("contact"), class: "inst-button inst-button--quiet" %>
          </div>
        <% end %>
      </section>

      <% if @faqs.any? %>
        <section class="inst-clause" id="questions" data-institute-clause>
          <div class="inst-clause__head">
            <p class="inst-clause__number">6</p>
            <h2 class="inst-clause__title">Questions</h2>
          </div>
          <dl class="inst-spec">
            <% @faqs.each do |faq| %>
              <div class="inst-spec__row">
                <dt class="inst-spec__label inst-question"><%= faq.question %></dt>
                <dd class="inst-spec__value"><%= faq.answer %></dd>
              </div>
            <% end %>
          </dl>
        </section>
      <% end %>

      <section class="inst-clause">
        <p class="inst-clause__standfirst inst-lead-in">Education</p>
        <p class="inst-standing">
          Materials, safety and use, explained without a sales pitch. The library carries the sources.
        </p>
        <div class="inst-actions">
          <%= link_to "Read the library", learn_path, class: "inst-button inst-button--quiet" %>
        </div>
      </section>
    </article>
  </div>
</div>
