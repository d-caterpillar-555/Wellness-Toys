<%# locals: (resource:) %>
<% if resource.errors.any? %>
  <div class="wt-panel mt-8 px-5 py-4" role="alert">
    <p class="text-ui text-ink"><%= t("forms.errors_heading") %></p>
    <ul class="mt-2 list-disc pl-5 text-body">
      <% resource.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
