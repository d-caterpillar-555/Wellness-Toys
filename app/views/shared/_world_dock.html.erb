<%# The world dock.
    Eight architectures, one small control. It is the only piece of chrome every
    world shares, so it has to stay out of the way: one line, fixed to the
    bottom-left corner, keyboard reachable, styled in this file rather than by
    any world, and dropped entirely in print. %>
<nav class="world-dock" aria-label="Design worlds">
  <ol class="world-dock__list">
    <% World.all.each do |world| %>
      <li>
        <%= link_to world.name, world.home_path,
              class: "world-dock__link",
              title: "#{world.tagline}: #{world.premise}",
              aria: { current: ("page" if world.current?(request)) } %>
      </li>
    <% end %>
  </ol>
  <%= link_to "The eight", worlds_path, class: "world-dock__index", title: "What each world is" %>
</nav>
