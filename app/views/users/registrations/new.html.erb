<% content_for :title, t("auth.sign_up.title") %>
<% content_for :meta_description, t("auth.sign_up.intro") %>

<section class="wt-container py-12 md:py-16">
  <div class="max-w-[34rem]">
    <h1 class="text-display-sm text-ink md:text-display"><%= t("auth.sign_up.title") %></h1>
    <p class="mt-4 text-lede text-body"><%= t("auth.sign_up.intro") %></p>

    <%= render "shared/form_errors", resource: resource %>

    <%= form_with model: resource, as: resource_name, url: registration_path(resource_name), class: "mt-10 space-y-6" do |form| %>
      <%= render "shared/field", form: form, attribute: :name, label: t("auth.fields.name"), autocomplete: "name" %>
      <%= render "shared/field", form: form, attribute: :email, label: t("auth.fields.email"), type: :email_field, autocomplete: "email" %>
      <%= render "shared/field", form: form, attribute: :phone, label: t("auth.fields.phone"), type: :telephone_field, autocomplete: "tel", required: false, hint: t("auth.hints.phone") %>
      <%= render "shared/field", form: form, attribute: :password, label: t("auth.fields.password"), type: :password_field, autocomplete: "new-password", hint: t("auth.hints.password", count: @minimum_password_length || Devise.password_length.min) %>
      <%= render "shared/field", form: form, attribute: :password_confirmation, label: t("auth.fields.password_confirmation"), type: :password_field, autocomplete: "new-password" %>

      <fieldset class="space-y-3 border-t border-line pt-6">
        <legend class="wt-label"><%= t("auth.sign_up.confirmations_legend") %></legend>
        <label class="flex items-start gap-3 text-body">
          <%= check_box_tag "user[age_confirmed]", "1", false, class: "mt-1", required: true %>
          <span><%= t("auth.sign_up.age_confirmed") %></span>
        </label>
        <label class="flex items-start gap-3 text-body">
          <%= check_box_tag "user[terms_accepted]", "1", false, class: "mt-1", required: true %>
          <span><%= t("auth.sign_up.terms_accepted") %></span>
        </label>
      </fieldset>

      <div class="pt-2">
        <%= form.submit t("auth.sign_up.submit"), class: "wt-btn wt-btn--primary w-full" %>
        <p class="wt-hint">
          <%= link_to t("auth.sign_up.sign_in_link"), new_user_session_path, class: "text-accent" %>
        </p>
      </div>
    <% end %>
  </div>
</section>
