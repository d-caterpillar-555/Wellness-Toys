<%# locals: (item:) %>
<li class="flex flex-wrap items-start justify-between gap-x-8 gap-y-4 border-b border-line py-6">
  <div class="min-w-[12rem]">
    <p class="text-title text-ink"><%= item.variant.product.name %></p>
    <p class="mt-1 text-caption text-muted"><%= item.variant.name %></p>
    <p class="mt-1 text-caption text-muted tnum"><%= item.variant.sku %></p>
  </div>

  <p class="text-ui text-ink tnum"><%= price(item.unit_price_cents, currency: item.variant.currency) %></p>

  <div class="flex items-end gap-3">
    <%= form_with url: cart_item_path(item), method: :patch, class: "flex items-end gap-2" do |form| %>
      <div>
        <%= form.label :quantity, t("cart.quantity"), class: "wt-label" %>
        <%= form.select :quantity, quantity_options, { selected: item.quantity }, class: "wt-input" %>
      </div>
      <%= form.submit t("cart.update"), class: "wt-btn wt-btn--secondary" %>
    <% end %>

    <%= button_to t("cart.remove"), cart_item_path(item), method: :delete, class: "wt-btn wt-btn--quiet" %>
  </div>

  <p class="text-ui text-ink tnum"><%= price(item.line_total_cents, currency: item.variant.currency) %></p>
</li>
