<% content_for :title, @author.name %>
<% content_for :meta_description, @author.bio.presence || "#{@author.name} writes for the #{Store.name} education library." %>

<% content_for :structured_data do %>
  <%= json_ld(breadcrumb_schema([ [ "Learn", learn_path ], [ "Writers", learn_experts_path ], [ @author.name, request.path ] ])) %>
  <%= json_ld(person_schema(@author)) %>
<% end %>

<section class="wt-container pt-12 pb-8 md:pt-16" data-controller="reveal" data-reveal>
  <nav aria-label="Breadcrumb" class="text-caption">
    <%= link_to "Learn", learn_path, class: "text-body no-underline hover:text-ink" %>
    <span aria-hidden="true" class="text-muted"> / </span>
    <%= link_to "Writers", learn_experts_path, class: "text-body no-underline hover:text-ink" %>
    <span aria-hidden="true" class="text-muted"> / </span>
    <span class="text-ink" aria-current="page"><%= @author.name %></span>
  </nav>

  <h1 class="mt-4 text-display-sm text-ink md:text-display"><%= @author.name %></h1>

  <% if @author.is_clinician? %>
    <p class="mt-4"><%= tag.span("Clinician", class: "wt-mark wt-mark--accent") %></p>
  <% end %>

  <% if @author.bio.present? %>
    <p class="mt-6 max-w-[68ch] text-lede text-body"><%= @author.bio %></p>
  <% end %>

  <%# Credentials are rendered only when the writer has stated them. An empty
      block is honest; a filled-in guess would not be. %>
  <% if @author.has_credentials? %>
    <div class="mt-10 max-w-[68ch] border-t border-line pt-6">
      <h2 class="text-label font-medium tracking-label text-ink">Credentials</h2>
      <p class="mt-3 text-body"><%= @author.credentials %></p>
    </div>
  <% end %>
</section>

<section class="wt-container pb-20" data-controller="reveal" data-reveal>
  <h2 class="text-heading-sm text-ink">Articles by <%= @author.name %></h2>

  <% if @articles.any? %>
    <div class="mt-8 grid gap-x-8 gap-y-10 md:grid-cols-2 lg:grid-cols-3">
      <% @articles.each do |article| %>
        <%= render "articles/card", article: article %>
      <% end %>
    </div>
  <% else %>
    <p class="mt-4 max-w-[52ch] text-body">Nothing published under this name yet.</p>
  <% end %>
</section>
