<% content_for :title, @category.name %>
<% content_for :meta_description, @category.description.presence || "Products in the #{@category.name} category from #{Store.name}." %>

<section class="wt-container pt-12 pb-8 md:pt-16">
  <nav aria-label="Breadcrumb" class="text-caption">
    <%= link_to "Shop", shop_path, class: "text-body no-underline hover:text-ink" %>
    <span aria-hidden="true" class="text-muted"> / </span>
    <span class="text-ink" aria-current="page"><%= @category.name %></span>
  </nav>

  <h1 class="mt-4 text-display-sm text-ink md:text-display"><%= @category.name %></h1>

  <% if @category.description.present? %>
    <p class="mt-4 max-w-[68ch] text-lede text-body"><%= @category.description %></p>
  <% end %>

  <p class="mt-3 text-ui text-muted tnum"><%= pluralize(@pagy.count, "product") %></p>
</section>

<% if @children.any? %>
  <section class="wt-container pb-10">
    <h2 class="text-label font-medium tracking-label text-ink">Narrow it down</h2>
    <ul class="mt-4 flex flex-wrap gap-2">
      <% @children.each do |child| %>
        <li>
          <%= link_to child.name, category_path(child), class: "wt-badge min-h-[44px] px-4 text-ui text-body hover:border-ink hover:text-ink" %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>

<section class="wt-container pb-20" data-controller="reveal" data-reveal>
  <h2 class="sr-only">Products</h2>

  <% if @products.any? %>
    <div class="grid grid-cols-1 gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      <% @products.each do |product| %>
        <%= render "products/card", product: product %>
      <% end %>
    </div>
    <%= render "shared/pagination", pagy: @pagy %>
  <% else %>
    <div class="max-w-[52ch] border-t border-line pt-8">
      <p class="text-lede text-ink">Nothing in this category yet.</p>
      <p class="mt-3 text-body">The shelf is being stocked. The rest of the catalogue is open in the meantime.</p>
      <%= link_to "See every product", shop_path, class: "wt-btn wt-btn--secondary mt-6" %>
    </div>
  <% end %>
</section>
