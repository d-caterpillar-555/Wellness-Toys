<% content_for :title, @category.name %>
<% content_for :meta_description, "#{@category.name} at #{Store.name}: every object in the department, kept as a register." %>

<div class="inst">
  <header class="inst-run">
    <p class="inst-run__mark"><%= link_to Store.name, root_path, class: "inst-link" %></p>
    <p class="inst-run__section">
      <%= link_to "Catalogue", shop_path, class: "inst-link" %> &middot; Department
    </p>
    <p><%= pluralize(@pagy.count, "object") %></p>
  </header>

  <div class="inst-body">
    <nav class="inst-rail" aria-label="Contents" data-institute-rail>
      <p class="inst-rail__title">Contents</p>
      <ol class="inst-rail__list">
        <li><a class="inst-rail__link" href="#department"><span class="inst-rail__number">1</span>The register</a></li>
        <% if @children.any? %>
          <li><a class="inst-rail__link" href="#subdepartments"><span class="inst-rail__number">2</span>Sub-departments</a></li>
        <% end %>
      </ol>
    </nav>

    <article class="inst-sheet inst-sheet--wide">
      <section class="inst-clause" id="department" data-institute-clause>
        <div class="inst-clause__head">
          <p class="inst-clause__number">1</p>
          <h1 class="inst-clause__title"><%= @category.name %></h1>
        </div>
        <p class="inst-clause__standfirst">
          Everything the shop keeps in this department today. The count is what is available,
          not what has been ordered.
        </p>

        <% if @products.any? %>
          <ol class="inst-ledger">
            <% @products.each do |product| %>
              <% row = capture do %>
                <span class="inst-ledger__plate"><%= product_cover_tag(product) %></span>
                <span>
                  <span class="inst-ledger__name"><%= product.name %></span>
                  <span class="inst-ledger__meta">
                    <%= product.primary_category&.name || "Catalogue" %>
                    <% if product.brand %> &middot; <%= product.brand.name %><% end %>
                    <% unless product.in_stock? %> &middot; Out of stock<% end %>
                  </span>
                </span>
                <span class="inst-ledger__price"><%= price(product.lowest_price_cents) %></span>
              <% end %>

              <li>
                <% if product.primary_category %>
                  <%= link_to product_path(product.primary_category, product), class: "inst-ledger__row" do %>
                    <%= row %>
                  <% end %>
                <% else %>
                  <div class="inst-ledger__row inst-ledger__row--plain"><%= row %></div>
                <% end %>
              </li>
            <% end %>
          </ol>

          <%= render "shared/pagination", pagy: @pagy %>
        <% else %>
          <p class="inst-standing">
            Nothing in this category yet. An empty shelf is a fact; we would rather show it than
            fill it.
          </p>
        <% end %>
      </section>

      <% if @children.any? %>
        <section class="inst-clause" id="subdepartments" data-institute-clause>
          <div class="inst-clause__head">
            <p class="inst-clause__number">2</p>
            <h2 class="inst-clause__title">Sub-departments</h2>
          </div>
          <ol class="inst-register">
            <% @children.each do |child| %>
              <li>
                <%= link_to category_path(child), class: "inst-register__row" do %>
                  <span class="inst-register__name"><%= child.name %></span>
                  <span class="inst-register__count"><%= pluralize(child.catalogue_count, "object") %></span>
                <% end %>
              </li>
            <% end %>
          </ol>
        </section>
      <% end %>
    </article>
  </div>
</div>
