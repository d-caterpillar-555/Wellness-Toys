<% content_for :title, "The plan" %>
<% content_for :meta_description, "The shop as a floor plan: departments are rooms, and you navigate by walking into them. The register lists everything without the walk." %>

<div class="plan">
  <header class="plan-masthead">
    <p class="plan-wordmark"><%= link_to Store.name, plan_path, class: "plan-wordmark" %></p>
    <nav aria-label="Sections">
      <ul class="plan-masthead__links">
        <li><%= link_to "The plan", plan_path, class: "plan-masthead__link", aria: { current: "page" } %></li>
        <li><%= link_to "The register", plan_register_path, class: "plan-masthead__link" %></li>
        <li><%= link_to "The shop", root_path, class: "plan-masthead__link" %></li>
      </ul>
    </nav>
  </header>

  <main class="plan-sheet" id="main">
    <header class="plan-head">
      <div>
        <h1 class="plan-title">The plan</h1>
        <p class="plan-standfirst">
          Six rooms, one corridor, and every object the shop keeps. Walk into a room to see what
          is in it, or take the register if you would rather have the list.
        </p>
      </div>
      <p class="plan-stamp">
        Sheet 01 &middot; <%= pluralize(@objects.size, "object") %> &middot;
        <%= pluralize(@departments.length, "department") %>
      </p>
    </header>

    <%= render "worlds/plan/board", rooms: @rooms, empty_rooms: @empty_rooms %>

    <p class="plan-readout" data-plan-readout>
      Point at a room. Tab moves through them too.
    </p>

    <ol class="plan-legend">
      <% @rooms.each_with_index do |entry, index| %>
        <li class="plan-legend__item">
          <%= link_to plan_room_path(entry[:category]), class: "plan-legend__link" do %>
            <span class="plan-legend__name">R<%= index + 1 %> &middot; <%= entry[:category].name %></span>
            <span class="plan-legend__count"><%= pluralize(entry[:category].catalogue_count, "object") %></span>
          <% end %>
        </li>
      <% end %>
    </ol>
  </main>
</div>
