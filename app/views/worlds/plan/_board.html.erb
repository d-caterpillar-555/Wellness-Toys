<%# locals: (rooms:, empty_rooms:, current: nil, marker: true) %>
<%# The drawing. Rooms are links, so the plan is the navigation: tab through it
    and every room is reachable, with the marker and the readout following. %>
<svg class="plan-board" viewBox="0 0 1000 640" role="img" aria-label="Floor plan of the shop" data-plan-board>
  <rect class="plan-walls" x="20" y="20" width="960" height="560" />
  <rect class="plan-corridor" x="20" y="272" width="960" height="56" />
  <text class="plan-room__count" x="40" y="304">CORRIDOR &middot; R0</text>

  <% rooms.each_with_index do |entry, index| %>
    <% category = entry[:category] %>
    <% room = entry[:room] %>
    <a class="plan-room" href="<%= plan_room_path(category) %>"
       data-plan-room
       data-x="<%= room[:x] + room[:w] / 2 %>"
       data-y="<%= room[:y] + room[:h] / 2 %>"
       data-name="<%= category.name %>"
       data-count="<%= pluralize(category.catalogue_count, "object") %>"<% if current == category %> aria-current="true"<% end %>>
      <rect x="<%= room[:x] %>" y="<%= room[:y] %>" width="<%= room[:w] %>" height="<%= room[:h] %>" />
      <text class="plan-room__name" x="<%= room[:x] + 16 %>" y="<%= room[:y] + 36 %>"><%= category.name.upcase %></text>
      <text class="plan-room__count" x="<%= room[:x] + 16 %>" y="<%= room[:y] + 56 %>">
        R<%= index + 1 %> &middot; <%= pluralize(category.catalogue_count, "object") %>
      </text>
      <% door_y = room[:y] < 272 ? room[:y] + room[:h] : room[:y] %>
      <line class="plan-room__door"
            x1="<%= room[:x] + room[:w] / 2 - 24 %>" y1="<%= door_y %>"
            x2="<%= room[:x] + room[:w] / 2 + 24 %>" y2="<%= door_y %>" />
    </a>
  <% end %>

  <% empty_rooms.each do |room| %>
    <rect class="plan-room__empty" x="<%= room[:x] %>" y="<%= room[:y] %>" width="<%= room[:w] %>" height="<%= room[:h] %>" />
    <text class="plan-room__count" x="<%= room[:x] + 16 %>" y="<%= room[:y] + 36 %>">UNLET &middot; NO DEPARTMENT</text>
  <% end %>

  <g class="plan-dimension">
    <line x1="20" y1="602" x2="980" y2="602" />
    <line x1="20" y1="595" x2="20" y2="609" />
    <line x1="980" y1="595" x2="980" y2="609" />
    <text x="500" y="620" text-anchor="middle">1000 plan units &middot; drawn to the sheet, not to a physical scale</text>
  </g>

  <g class="plan-scale">
    <line x1="60" y1="602" x2="160" y2="602" />
    <line x1="60" y1="596" x2="60" y2="608" />
    <line x1="110" y1="598" x2="110" y2="606" />
    <line x1="160" y1="596" x2="160" y2="608" />
    <circle cx="900" cy="80" r="18" />
    <line x1="900" y1="80" x2="900" y2="48" />
    <text x="900" y="72" text-anchor="middle">N</text>
  </g>

  <% if marker %>
    <g class="plan-marker" data-plan-marker transform="translate(500 300)">
      <circle r="7" />
      <circle class="plan-marker__ring" r="15" />
    </g>
  <% end %>
</svg>
