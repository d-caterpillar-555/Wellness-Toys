<% content_for :title, "Pieces" %>
<% content_for :meta_description, "Every piece in the catalogue: materials, body safety and dimensions stated before description." %>

<div class="figure">
  <header class="fig-masthead">
    <p class="fig-wordmark"><%= link_to Store.name, figure_path, class: "fig-wordmark" %></p>
    <nav aria-label="Sections">
      <ul class="fig-masthead__links">
        <li><%= link_to "The choreography", figure_path, class: "fig-masthead__link" %></li>
        <li><%= link_to "The pieces", figure_pieces_path, class: "fig-masthead__link", aria: { current: "page" } %></li>
        <li><%= link_to "The shop", root_path, class: "fig-masthead__link" %></li>
      </ul>
    </nav>
  </header>

  <main class="fig-pieces" id="main">
    <header class="fig-pieces__head">
      <h1 class="fig-pieces__title">The pieces</h1>
      <p class="fig-pieces__standfirst">
        <%= pluralize(@pieces.size, "object") %> in
        <%= pluralize(@departments.size, "department") %>. Each one is documented before it is
        described.
      </p>
    </header>

    <% if @pieces.any? %>
      <ol class="fig-grid">
        <% @pieces.each do |product| %>
          <li>
            <%= link_to figure_piece_path(product.slug), class: "fig-card" do %>
              <span class="fig-card__plate"><%= product_cover_tag(product) %></span>
              <span class="fig-card__name"><%= product.name %></span>
              <span class="fig-card__meta">
                <%= product.primary_category&.name || "Catalogue" %>
                &middot; <%= price(product.lowest_price_cents) %>
              </span>
            <% end %>
          </li>
        <% end %>
      </ol>
    <% else %>
      <p class="fig-chapter__body">The catalogue is empty right now.</p>
    <% end %>
  </main>
</div>
