<% content_for :title, "Notices" %>
<% content_for :meta_description, "The small print, set as notices: standards, shipping, returns, privacy, terms and accessibility." %>

<main class="press-page" id="main">
  <header>
    <p class="press-kicker">Notices</p>
    <h1 class="press-headline">The small print</h1>
    <p class="press-deck">
      The pages a shop usually hides in the footer, set here as notices where they can be read.
    </p>
  </header>

  <section class="press-section" aria-labelledby="notices-heading">
    <h2 class="press-section__title" id="notices-heading">Standing notices</h2>

    <div class="press-notices">
      <% @pages.each do |page| %>
        <div class="press-notice">
          <h3 class="press-notice__title"><%= page.title %></h3>
          <% if page.paragraphs.any? %>
            <p><%= truncate(page.paragraphs.first, length: 240) %></p>
          <% else %>
            <p>Not yet written. We would rather leave the notice short than fill it.</p>
          <% end %>
          <p><%= link_to "The notice in full", page_path(page.slug) %></p>
        </div>
      <% end %>
    </div>
  </section>

  <section class="press-section" aria-labelledby="figures-heading">
    <h2 class="press-section__title" id="figures-heading">Where to write</h2>
    <p>
      Support: <%= mail_to Store.support_email, Store.support_email %> &middot;
      Privacy: <%= mail_to Store.privacy_email, Store.privacy_email %> &middot;
      Press: <%= mail_to Store.press_email, Store.press_email %>
    </p>
    <p class="press-byline"><%= Store.legal_entity %> &middot; You must be of legal age in your jurisdiction to purchase.</p>
  </section>

  <footer class="press-folio">
    <span><%= Store.name %> &middot; No. 1</span>
    <span>Notices</span>
    <span><%= link_to "Front page", press_path %></span>
  </footer>
</main>
