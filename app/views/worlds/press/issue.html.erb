<% content_for :title, "This issue" %>
<% content_for :meta_description, "This issue's features: the guides and explainers from the library, with their writers and their sources." %>

<main class="press-page" id="main">
  <header>
    <p class="press-kicker">This issue</p>
    <h1 class="press-headline">What we published</h1>
    <p class="press-deck">
      <%= pluralize(@counts[:pieces], "piece") %> in this edition. Every one is written by a named
      person, and every claim that needed a source has one printed at the foot of the piece.
    </p>
  </header>

  <section class="press-section" aria-labelledby="features">
    <h2 class="press-section__title" id="features">Features</h2>

    <div class="press-columns">
      <% @features.each do |article| %>
        <% topic = article.primary_topic || article.topics.first %>
        <article class="press-story">
          <h3 class="press-story__headline">
            <%= link_to article.title,
                  topic ? press_story_path(topic.slug, article.slug) : press_issue_path %>
          </h3>
          <% if article.excerpt.present? %>
            <p class="press-story__deck"><%= article.excerpt %></p>
          <% end %>
          <p class="press-byline">
            <% if article.author %>By <%= article.author.name %><% else %>Unsigned<% end %>
            &middot; <%= article.kind %>
            <% if article.reading_minutes %> &middot; <%= article.reading_minutes %> min<% end %>
          </p>
        </article>
      <% end %>
    </div>
  </section>

  <footer class="press-folio">
    <span><%= Store.name %> &middot; No. 1</span>
    <span>This issue</span>
    <span><%= link_to "Front page", press_path %></span>
  </footer>
</main>
