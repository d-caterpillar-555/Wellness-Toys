<%# locals: (product:) %>
<%# One review entry. The paper has no separate object page: the entry carries
    the specification, the price and the order form, the way a mail-order
    column did. %>
<li class="press-review">
  <h3 class="press-review__name"><%= product.name %></h3>
  <p class="press-review__meta">
    <%= product.primary_category&.name || "Catalogue" %>
    <% if product.brand %> &middot; <%= product.brand.name %><% end %>
    &middot; <%= product.sku %>
  </p>

  <% if product.materials.present? %>
    <p class="press-review__meta">
      <%= product.materials %><% if product.dimensions.present? %> &middot; <%= product.dimensions %><% end %>
      &middot; body safe: <%= product.body_safe? ? "yes" : "no" %>
    </p>
  <% end %>

  <% if product.description.present? %>
    <p class="press-review__body"><%= truncate(product.description, length: 180) %></p>
  <% end %>

  <p class="press-review__price"><%= price(product.lowest_price_cents) %></p>

  <% variants = product.variants.select(&:active?) %>
  <% if variants.any? %>
    <%= form_with url: cart_items_path, method: :post, class: "press-review__buy" do %>
      <label class="press-review__meta" for="variant_<%= product.id %>">Edition</label>
      <%= select_tag "variant_id",
            options_for_select(variants.map { |variant|
              label = strip_tags(price(variant.price_cents, currency: variant.currency))
              [ "#{variant.name} - #{label}", variant.id ]
            }), id: "variant_#{product.id}" %>

      <%= select_tag "quantity", options_for_select(quantity_options), id: "quantity_#{product.id}", aria: { label: "Quantity" } %>
      <%= submit_tag t("products.add_to_cart") %>
    <% end %>
  <% else %>
    <p class="press-review__meta">No edition available.</p>
  <% end %>
</li>
