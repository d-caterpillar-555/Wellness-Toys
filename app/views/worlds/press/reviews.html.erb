<% content_for :title, "The review section" %>
<% content_for :meta_description, "Every object in the catalogue, reviewed: materials, dimensions, price and the order column." %>

<main class="press-page" id="main">
  <header>
    <p class="press-kicker">The review section</p>
    <h1 class="press-headline">The objects</h1>
    <p class="press-deck">
      <%= pluralize(@counts[:objects], "object") %> across <%= pluralize(@counts[:departments], "department") %>.
      Each entry carries its specification and its order column; there is no separate product
      page in this paper.
    </p>
  </header>

  <% @departments.each do |category| %>
    <% entries = @objects.select { |product| product.primary_category&.id == category.id } %>
    <% next if entries.empty? %>
    <section class="press-section" aria-labelledby="dept-<%= category.slug %>">
      <h2 class="press-section__title" id="dept-<%= category.slug %>"><%= category.name %></h2>
      <ol class="press-reviews">
        <% entries.each do |product| %>
          <%= render "worlds/press/review", product: product %>
        <% end %>
      </ol>
    </section>
  <% end %>

  <% unfiled = @objects.reject(&:primary_category) %>
  <% if unfiled.any? %>
    <section class="press-section" aria-labelledby="unfiled">
      <h2 class="press-section__title" id="unfiled">Unfiled</h2>
      <ol class="press-reviews">
        <% unfiled.each do |product| %>
          <%= render "worlds/press/review", product: product %>
        <% end %>
      </ol>
    </section>
  <% end %>

  <footer class="press-folio">
    <span><%= Store.name %> &middot; No. 1</span>
    <span>Reviews</span>
    <span><%= link_to "Front page", press_path %></span>
  </footer>
</main>
