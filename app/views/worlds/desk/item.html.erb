<% content_for :title, @product.name %>
<% content_for :meta_description, @product.subtitle.presence || "#{@product.name}, brought to the desk at #{Store.name}." %>

<main class="desk-page" id="main">
  <p class="desk-offer__meta">
    Brought to the desk
    <% if @department %> &middot; <%= @department.name %><% end %>
    &middot; <%= @product.sku %>
  </p>

  <div class="desk-item">
    <div class="desk-item__plate"><%= product_cover_tag(@product) %></div>

    <div>
      <h1 class="desk-item__title"><%= @product.name %></h1>
      <% if @product.subtitle.present? %>
        <p class="desk-note"><%= @product.subtitle %></p>
      <% end %>
      <p class="desk-item__price"><%= price(@product.lowest_price_cents) %></p>

      <dl class="desk-figures">
        <% if @product.materials.present? %>
          <div class="desk-figure">
            <dt>Materials</dt>
            <dd><%= @product.materials %></dd>
          </div>
        <% end %>
        <div class="desk-figure">
          <dt>Body safe</dt>
          <dd><%= @product.body_safe? ? "Yes" : "No" %></dd>
        </div>
        <% if @product.safety_notes.present? %>
          <div class="desk-figure">
            <dt>Safety notes</dt>
            <dd><%= @product.safety_notes %></dd>
          </div>
        <% end %>
        <% if @product.dimensions.present? %>
          <div class="desk-figure">
            <dt>Dimensions</dt>
            <dd><%= @product.dimensions %></dd>
          </div>
        <% end %>
        <% if @product.weight_grams.present? %>
          <div class="desk-figure">
            <dt>Weight</dt>
            <dd><%= @product.weight_grams %> g</dd>
          </div>
        <% end %>
      </dl>

      <% if @product.description.present? %>
        <p class="desk-note"><%= @product.description %></p>
      <% end %>
      <% if @product.care_instructions.present? %>
        <p class="desk-note"><%= @product.care_instructions %></p>
      <% end %>

      <% if @variants.any? %>
        <%= form_with url: cart_items_path, method: :post, class: "desk-buy" do %>
          <label class="desk-figure" for="variant_id">Edition</label>
          <%= select_tag "variant_id",
                options_for_select(@variants.map { |variant|
                  label = strip_tags(price(variant.price_cents, currency: variant.currency))
                  [ "#{variant.name} - #{label}", variant.id ]
                }), id: "variant_id" %>

          <%= select_tag "quantity", options_for_select(quantity_options), id: "quantity", aria: { label: "Quantity" } %>
          <%= submit_tag t("products.add_to_cart"), class: "desk-buy__submit" %>
        <% end %>
      <% else %>
        <p class="desk-note">No edition of this object is available right now.</p>
      <% end %>
    </div>
  </div>

  <% if @related.any? %>
    <section>
      <h2 class="desk-side__title">Also on the shelf in <%= @department&.name || "the catalogue" %></h2>
      <ol class="desk-grid">
        <% @related.each do |product| %>
          <li>
            <%= link_to desk_item_path(product.slug), class: "desk-card" do %>
              <span class="desk-card__plate"><%= product_cover_tag(product) %></span>
              <span class="desk-card__name"><%= product.name %></span>
              <span class="desk-card__meta"><%= price(product.lowest_price_cents) %></span>
            <% end %>
          </li>
        <% end %>
      </ol>
    </section>
  <% end %>

  <p class="desk-note">
    <%= link_to "Back to the desk", desk_path %> &middot;
    <%= link_to "The whole shelf", desk_shelf_path %>
  </p>
</main>
