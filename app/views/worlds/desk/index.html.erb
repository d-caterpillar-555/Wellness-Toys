<% content_for :title, "The desk" %>
<% content_for :meta_description, "A concierge for #{Store.name}: tell it what you need and it brings the objects, the library and the notices to the desk. A script, not a clinician." %>

<div class="desk" id="main"
     data-desk
     data-library-url="<%= learn_path %>"
     data-shipping-url="<%= page_path("shipping") %>"
     data-privacy-url="<%= page_path("privacy") %>">
  <div class="desk-room">
    <div>
      <h1 class="desk-intro">The desk</h1>
      <p class="desk-note">
        A scripted concierge. It is not a person and it is not a clinician: where a question is
        medical it will say so and point you at the library. Everything it brings over is a real
        object from the shelf, and every answer is also a link.
      </p>

      <div class="desk-transcript" data-desk-transcript role="log" aria-live="polite" aria-label="Conversation"></div>

      <div class="desk-replies" data-desk-replies></div>

      <form class="desk-form" data-desk-form>
        <input class="desk-form__input"
               type="search"
               name="query"
               placeholder="ask about an object, or type a word"
               aria-label="Ask the desk">
        <button class="desk-form__submit" type="submit">Ask</button>
      </form>
    </div>

    <aside class="desk-side">
      <h2 class="desk-side__title">Departments on the shelf</h2>
      <ul class="desk-shelf">
        <% @departments.each do |category| %>
          <li class="desk-shelf__item">
            <%= link_to category.name, desk_shelf_path(anchor: "dept-#{category.slug}"), class: "desk-shelf__link" %>
            <p class="desk-shelf__meta"><%= pluralize(category.catalogue_count, "object") %></p>
          </li>
        <% end %>
      </ul>
      <p><%= link_to "The whole shelf", desk_shelf_path %></p>

      <h2 class="desk-side__title">In the library</h2>
      <ul class="desk-shelf">
        <% @reading.each do |article| %>
          <% topic = article.primary_topic || article.topics.first %>
          <li class="desk-shelf__item">
            <%= link_to article.title,
                  topic ? learn_article_path(topic.slug, article.slug) : learn_path,
                  class: "desk-shelf__link" %>
            <p class="desk-shelf__meta">
              <%= article.kind %><% if article.author %> &middot; <%= article.author.name %><% end %>
            </p>
          </li>
        <% end %>
      </ul>
    </aside>
  </div>

  <script type="application/json" data-desk-shelf nonce="<%= content_security_policy_nonce %>"><%= raw json_escape(@shelf.to_json) %></script>
</div>
