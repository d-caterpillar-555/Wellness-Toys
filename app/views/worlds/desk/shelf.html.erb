<% content_for :title, "The shelf" %>
<% content_for :meta_description, "The whole shelf at #{Store.name}, quietly: every object with its department, its line and its price." %>

<div class="desk-page">
  <h1 class="desk-intro">The shelf</h1>
  <p class="desk-note">
    Everything the desk can bring you, without the conversation.
  </p>

  <% @departments.each do |category| %>
    <% entries = @objects.select { |product| product.primary_category&.id == category.id } %>
    <% next if entries.empty? %>
    <section id="dept-<%= category.slug %>">
      <h2 class="desk-side__title"><%= category.name %> &middot; <%= pluralize(entries.size, "object") %></h2>
      <ol class="desk-grid">
        <% entries.each do |product| %>
          <li>
            <%= link_to desk_item_path(product.slug), class: "desk-card" do %>
              <span class="desk-card__plate"><%= product_cover_tag(product) %></span>
              <span class="desk-card__name"><%= product.name %></span>
              <span class="desk-card__meta"><%= price(product.lowest_price_cents) %></span>
            <% end %>
          </li>
        <% end %>
      </ol>
    </section>
  <% end %>
</div>
