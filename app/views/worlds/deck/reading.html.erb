<% content_for :title, "Library" %>
<% content_for :meta_description, "The publishing side of the shop, as a console pane: every piece with its writer, its kind and its sources." %>

<header class="deck-top">
  <h1 class="deck-top__title">Library</h1>
  <p class="deck-top__count"><%= pluralize(@reading.size, "piece") %></p>
</header>

<main class="deck-main" id="main">
  <ul class="deck-list">
    <% @reading.each do |article| %>
      <% topic = article.primary_topic || article.topics.first %>
      <li class="deck-list__row">
        <%= link_to article.title,
              topic ? learn_article_path(topic.slug, article.slug) : learn_path,
              class: "deck-list__link" %>
        <span class="deck-list__meta">
          <%= article.kind %>
          <% if article.author %> &middot; <%= article.author.name %><% end %>
          <% if article.published_at %> &middot; <%= article.published_at.strftime("%Y-%m-%d") %><% end %>
          &middot; <%= article.sources.size %> src
        </span>
      </li>
    <% end %>
  </ul>

  <p class="deck-note">
    Every piece carries its sources on its own page. The library is also readable in the
    shop's own architecture: <%= link_to "the library", learn_path %>.
  </p>
</main>
