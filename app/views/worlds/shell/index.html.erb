<% content_for :title, "shell" %>
<% content_for :meta_description, "The shop as a command line: list the catalogue, read an object, search the library, put something in the basket - by typing." %>

<%# One surface. The tree is published as a data block rather than built in
    JavaScript, so every path the terminal resolves is a record. %>
<div class="shell" id="main">
  <header class="shell-head">
    <p class="shell-head__name"><%= Store.name %> shell</p>
    <nav class="shell-head__links" aria-label="Elsewhere">
      <%= link_to "the shop", root_path, class: "shell-head__link" %>
      <%= link_to "the eight architectures", worlds_path, class: "shell-head__link" %>
      <%= link_to "the register", plan_register_path, class: "shell-head__link" %>
    </nav>
  </header>

  <div class="shell-body" data-shell data-focus="<%= @focus %>">
    <div class="shell-screen" data-shell-screen role="log" aria-live="polite" aria-label="Session output"></div>

    <div class="shell-prompt">
      <label class="shell-prompt__label" for="shell-input">$</label>
      <input class="shell-prompt__input"
             id="shell-input"
             data-shell-input
             type="text"
             autocomplete="off"
             autocapitalize="off"
             autocorrect="off"
             spellcheck="false"
             placeholder="help"
             aria-label="Command">
    </div>
  </div>

  <script type="application/json" data-shell-tree nonce="<%= content_security_policy_nonce %>"><%= raw json_escape(@tree.to_json) %></script>

  <noscript>
    <div class="shell-fallback">
      <p>The terminal needs JavaScript. The same records, as links:</p>
      <ul>
        <% @objects.each do |product| %>
          <li><%= link_to product.name, shell_object_path(product.slug) %></li>
        <% end %>
      </ul>
    </div>
  </noscript>
</div>
