<% content_for :title, t("cart.title") %>
<% content_for :meta_description, t("cart.empty_body") %>

<section class="wt-container py-12 md:py-16">
  <h1 class="text-display-sm text-ink md:text-display"><%= t("cart.heading") %></h1>

  <% if @items.any? %>
    <div class="mt-10 grid gap-12 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-16">
      <ul class="border-t border-line">
        <% @items.each do |item| %>
          <%= render "cart/items/line", item: item %>
        <% end %>
      </ul>

      <aside class="lg:border-l lg:border-line lg:pl-8">
        <div class="wt-panel p-6">
          <div class="flex items-baseline justify-between gap-4">
            <span class="text-ui text-muted"><%= t("cart.subtotal") %></span>
            <span class="text-title text-ink"><%= cart_total_label(@cart) %></span>
          </div>
          <p class="wt-hint"><%= t("cart.shipping_note") %></p>
          <%= link_to t("cart.checkout"), new_checkout_path, class: "wt-btn wt-btn--primary mt-6 w-full" %>
        </div>
      </aside>
    </div>
  <% else %>
    <div class="mt-10 max-w-[52ch] border-t border-line pt-8">
      <p class="text-lede text-ink"><%= t("cart.empty_heading") %></p>
      <p class="mt-3 text-body"><%= t("cart.empty_body") %></p>
      <%= link_to t("cart.empty_action"), shop_path, class: "wt-btn wt-btn--secondary mt-6" %>
    </div>
  <% end %>
</section>
