<%# locals: (order:, items:, events:) %>

<section class="mt-12">
  <h2 class="text-heading text-ink"><%= t("orders.show.items_heading") %></h2>

  <% if items.any? %>
    <ul class="mt-6 border-t border-line">
      <% items.each do |item| %>
        <li class="flex items-baseline justify-between gap-6 border-b border-line py-4">
          <div>
            <p class="text-ui text-ink"><%= item.product_name %></p>
            <p class="text-caption text-muted"><%= item.variant_name %> <span class="tnum"><%= item.sku %></span></p>
          </div>
          <div class="text-right">
            <p class="text-caption text-muted tnum"><%= item.quantity %> x <%= price(item.unit_price_cents, currency: item.currency) %></p>
            <p class="text-ui text-ink tnum"><%= price(item.line_total_cents, currency: item.currency) %></p>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-4 text-body text-muted"><%= t("orders.show.no_items") %></p>
  <% end %>
</section>

<section class="mt-12">
  <h2 class="text-heading text-ink"><%= t("orders.show.totals_heading") %></h2>
  <dl class="mt-6 max-w-[24rem] border-t border-line pt-6 text-ui">
    <div class="flex items-baseline justify-between gap-4 py-1">
      <dt class="text-muted"><%= t("orders.show.subtotal") %></dt>
      <dd class="text-ink"><%= price(order.subtotal_cents, currency: order.currency) %></dd>
    </div>
    <div class="flex items-baseline justify-between gap-4 py-1">
      <dt class="text-muted"><%= t("orders.show.shipping") %></dt>
      <dd class="text-ink"><%= price(order.shipping_cents, currency: order.currency) %></dd>
    </div>
    <div class="flex items-baseline justify-between gap-4 py-1">
      <dt class="text-muted"><%= t("orders.show.tax") %></dt>
      <dd class="text-ink"><%= price(order.tax_cents, currency: order.currency) %></dd>
    </div>
    <div class="mt-3 flex items-baseline justify-between gap-4 border-t border-line pt-3">
      <dt class="text-ink"><%= t("orders.show.total") %></dt>
      <dd class="text-title text-ink"><%= price(order.total_cents, currency: order.currency) %></dd>
    </div>
  </dl>
</section>

<section class="mt-12">
  <h2 class="text-heading text-ink"><%= t("orders.show.shipping_heading") %></h2>
  <p class="mt-6 text-body text-ink"><%= order.ship_to_recipient %></p>
  <p class="mt-1 text-body">
    <%= [ order.ship_to_line1, order.ship_to_line2, order.ship_to_city, order.ship_to_region, order.ship_to_postal_code, order.ship_to_country_code ].compact_blank.join(", ") %>
  </p>
</section>

<section class="mt-12">
  <h2 class="text-heading text-ink"><%= t("orders.show.timeline_heading") %></h2>

  <% if events.any? %>
    <ol class="mt-6 border-t border-line">
      <% events.each do |event| %>
        <li class="border-b border-line py-4">
          <p class="text-ui text-ink"><%= t("orders.events.#{event.kind}", default: event.kind.humanize) %></p>
          <p class="text-caption text-muted tnum"><%= event.created_at.utc.strftime("%-d %B %Y, %H:%M") %></p>
          <% if event.note.present? %>
            <p class="mt-1 text-body"><%= event.note %></p>
          <% end %>
        </li>
      <% end %>
    </ol>
  <% else %>
    <p class="mt-4 text-body text-muted"><%= t("orders.show.placed_fallback") %></p>
  <% end %>
</section>
