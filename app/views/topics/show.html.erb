<% content_for :title, @topic.name %>
<% content_for :meta_description, @topic.description.presence || "#{@topic.name} articles from the #{Store.name} education library." %>
<% kind_order = %w[pillar guide glossary post] %>
<% kind_headings = { "pillar" => "Overview", "guide" => "Guides", "glossary" => "Glossary", "post" => "Posts" } %>

<section class="wt-container pt-12 pb-8 md:pt-16" data-controller="reveal" data-reveal>
  <nav aria-label="Breadcrumb" class="text-caption">
    <%= link_to "Learn", learn_path, class: "text-body no-underline hover:text-ink" %>
    <span aria-hidden="true" class="text-muted"> / </span>
    <span class="text-ink" aria-current="page"><%= @topic.name %></span>
  </nav>

  <h1 class="mt-4 text-display-sm text-ink md:text-display"><%= @topic.name %></h1>

  <% if @topic.description.present? %>
    <p class="mt-4 max-w-[68ch] text-lede text-body"><%= @topic.description %></p>
  <% end %>

  <p class="mt-3 text-ui text-muted tnum"><%= pluralize(@topic.published_article_count, "article") %></p>
</section>

<% if @children.any? %>
  <section class="wt-container pb-10">
    <h2 class="text-label font-medium tracking-label text-ink">Narrow it down</h2>
    <ul class="mt-4 flex flex-wrap gap-2">
      <% @children.each do |child| %>
        <li>
          <%= link_to child.name, learn_topic_path(child), class: "wt-mark min-h-[44px] px-4 text-ui text-body hover:border-ink hover:text-ink" %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>

<div class="wt-container pb-20" data-controller="reveal" data-reveal>
  <% if @articles_by_kind.any? %>
    <% kind_order.each do |kind| %>
      <% articles = @articles_by_kind[kind] %>
      <% next if articles.blank? %>

      <section class="mt-12 border-t border-line pt-8 first:mt-0" aria-labelledby="kind-<%= kind %>">
        <h2 id="kind-<%= kind %>" class="text-heading-sm text-ink"><%= kind_headings.fetch(kind) %></h2>
        <div class="mt-6 grid gap-x-8 gap-y-10 md:grid-cols-2">
          <% articles.each do |article| %>
            <%= render "articles/card", article: article %>
          <% end %>
        </div>
      </section>
    <% end %>
  <% else %>
    <div class="max-w-[52ch] border-t border-line pt-8">
      <p class="text-lede text-ink">Nothing is published under this subject yet.</p>
      <p class="mt-3 text-body">The writing is in progress. The rest of the library is open in the meantime.</p>
      <%= link_to "Back to the library", learn_path, class: "wt-btn wt-btn--secondary mt-6" %>
    </div>
  <% end %>
</div>

<% if @recent_posts.any? %>
  <section class="border-t border-line bg-paper-sunk" data-controller="reveal" data-reveal>
    <div class="wt-container py-16 md:py-20">
      <h2 class="text-heading-sm text-ink">From the blog</h2>
      <ul class="mt-8 divide-y divide-line border-y border-line">
        <% @recent_posts.each do |post| %>
          <li>
            <%= link_to blog_post_path(post), class: "group flex items-baseline justify-between gap-6 py-5 no-underline" do %>
              <span class="text-title text-ink group-hover:text-accent"><%= post.title %></span>
              <span class="shrink-0 text-caption text-muted"><%= post.published_at&.to_date&.strftime("%-d %B %Y") %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  </section>
<% end %>
