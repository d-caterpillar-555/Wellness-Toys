<% content_for :title, "The education library" %>
<% content_for :meta_description, "Evergreen guides, a glossary and named experts, with the sources behind every claim. The #{Store.name} education library." %>

<section class="wt-container pt-20 pb-16 md:pt-28 md:pb-20" data-controller="reveal" data-reveal>
  <div class="max-w-[58rem]">
    <h1 class="text-display-lg text-ink md:text-display-xl">The education library.</h1>
    <p class="mt-8 max-w-[54ch] text-lede text-body">
      This is the part of the site that is not trying to sell you anything. Guides
      on how bodies and products actually work, a glossary of the words the
      subject is full of, and the sources behind every claim so you can check us.
    </p>
    <div class="mt-10 flex flex-wrap gap-3">
      <%= link_to "Open the glossary", learn_glossary_path, class: "wt-btn wt-btn--secondary" %>
      <%= link_to "Meet the writers", learn_experts_path, class: "wt-btn wt-btn--secondary" %>
    </div>
  </div>
</section>

<%# Topics as a hairline list rather than a card grid, so this layout family
    appears only here and the guide grid below reads as a different one. %>
<section class="border-t border-line" data-controller="reveal" data-reveal>
  <div class="wt-container py-16 md:py-24">
    <h2 class="text-heading text-ink md:text-heading-lg max-w-[24ch]">Start with a subject</h2>

    <% if @topics.any? %>
      <ul class="mt-10 divide-y divide-line border-y border-line">
        <% @topics.each do |topic| %>
          <li>
            <%= link_to learn_topic_path(topic), class: "group flex items-baseline justify-between gap-6 py-6 no-underline" do %>
              <span class="max-w-[54ch]">
                <span class="block text-title text-ink group-hover:text-accent"><%= topic.name %></span>
                <% if topic.description.present? %>
                  <span class="mt-2 block text-body"><%= topic.description %></span>
                <% end %>
              </span>
              <span class="shrink-0 text-caption text-muted tnum"><%= pluralize(topic.published_article_count, "article") %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-8 max-w-[52ch] text-body">The subjects are being written up. Check back shortly.</p>
    <% end %>
  </div>
</section>

<% if @latest_guides.any? %>
  <section class="border-t border-line bg-paper-sunk" data-controller="reveal" data-reveal>
    <div class="wt-container py-16 md:py-24">
      <h2 class="text-heading text-ink">Latest guides</h2>

      <div class="mt-10 grid gap-x-8 gap-y-10 md:grid-cols-3">
        <% @latest_guides.each do |article| %>
          <%= render "articles/card", article: article %>
        <% end %>
      </div>

      <%= link_to "Everything we have published", blog_path, class: "wt-btn wt-btn--quiet mt-10" %>
    </div>
  </section>
<% end %>

<section class="border-t border-line" data-controller="reveal" data-reveal>
  <div class="wt-container grid gap-10 py-16 md:grid-cols-2 md:py-20">
    <div class="border-t border-line pt-6">
      <h2 class="text-title text-ink">The glossary</h2>
      <p class="mt-3 max-w-[46ch] text-body">Short definitions of the words this subject is full of, written to be understood on the first read.</p>
      <%= link_to "Open the glossary", learn_glossary_path, class: "wt-btn wt-btn--secondary mt-6" %>
    </div>

    <div class="border-t border-line pt-6">
      <h2 class="text-title text-ink">The writers</h2>
      <p class="mt-3 max-w-[46ch] text-body">Every article is credited to a named person, with their credentials stated in their own words or left blank.</p>
      <%= link_to "Meet the writers", learn_experts_path, class: "wt-btn wt-btn--secondary mt-6" %>
    </div>
  </div>
</section>
