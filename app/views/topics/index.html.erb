<% content_for :title, "The library" %>
<% content_for :meta_description, "The education side of #{Store.name}: guides and explainers with their sources attached, organised by topic." %>

<div class="inst">
  <header class="inst-run">
    <p class="inst-run__mark"><%= link_to Store.name, root_path, class: "inst-link" %></p>
    <p class="inst-run__section">The library</p>
    <p><%= pluralize(@topics.length, "topic") %></p>
  </header>

  <div class="inst-body">
    <nav class="inst-rail" aria-label="Contents" data-institute-rail>
      <p class="inst-rail__title">Contents</p>
      <ol class="inst-rail__list">
        <li><a class="inst-rail__link" href="#topics"><span class="inst-rail__number">1</span>Topics</a></li>
        <% if @latest_guides.any? %>
          <li><a class="inst-rail__link" href="#guides"><span class="inst-rail__number">2</span>Latest guides</a></li>
        <% end %>
        <li><a class="inst-rail__link" href="#related"><span class="inst-rail__number">3</span>Also in the library</a></li>
      </ol>
    </nav>

    <article class="inst-sheet">
      <section class="inst-clause" id="topics" data-institute-clause>
        <div class="inst-clause__head">
          <p class="inst-clause__number">1</p>
          <h1 class="inst-clause__title">Topics</h1>
        </div>
        <p class="inst-clause__standfirst">
          The library is organised as topics, and each topic holds the guides that answer it.
          Every piece carries its sources on the page.
        </p>

        <ol class="inst-register">
          <% @topics.each do |topic| %>
            <li>
              <%= link_to learn_topic_path(topic), class: "inst-register__row" do %>
                <span class="inst-register__name"><%= topic.name %></span>
                <span class="inst-register__count"><%= pluralize(topic.published_article_count, "article") %></span>
              <% end %>
            </li>
          <% end %>
        </ol>
      </section>

      <% if @latest_guides.any? %>
        <section class="inst-clause" id="guides" data-institute-clause>
          <div class="inst-clause__head">
            <p class="inst-clause__number">2</p>
            <h2 class="inst-clause__title">Latest guides</h2>
          </div>

          <ul class="inst-reading-list">
            <% @latest_guides.each do |article| %>
              <% topic = article.primary_topic || article.topics.first %>
              <li class="inst-reading-list__item">
                <%= link_to article.title,
                      topic ? learn_article_path(topic.slug, article.slug) : learn_path,
                      class: "inst-reading-list__title" %>
                <p class="inst-reading-list__meta">
                  <% if article.author %> <%= article.author.name %> &middot; <% end %>
                  <% if article.reading_minutes %><%= article.reading_minutes %> min<% else %>Guide<% end %>
                </p>
              </li>
            <% end %>
          </ul>
        </section>
      <% end %>

      <section class="inst-clause" id="related" data-institute-clause>
        <div class="inst-clause__head">
          <p class="inst-clause__number">3</p>
          <h2 class="inst-clause__title">Also in the library</h2>
        </div>
        <div class="inst-actions">
          <%= link_to "Glossary of terms", learn_glossary_path, class: "inst-link" %>
          <%= link_to "Who writes it", learn_experts_path, class: "inst-link" %>
          <%= link_to "The blog", blog_path, class: "inst-link" %>
        </div>
      </section>
    </article>
  </div>
</div>
