<% content_for :title, nil %>
<% content_for :meta_description, "#{Store.name} sells sexual health and wellness products, and publishes the education that explains them. Evidence over euphemism, discretion as standard." %>

<%# The front page of the report. Contents first, the publication's own words
    second, then the register, the catalogue head and the library. Every section
    is a clause with a number, and the rail on the left is the page's own
    contents - the instrument the whole architecture is built around. %>
<div class="inst">
  <header class="inst-run">
    <p class="inst-run__mark"><%= Store.name %></p>
    <p class="inst-run__section">Front matter</p>
    <p>Vol. 1 &middot; <%= @register.sum(&:catalogue_count) %> objects &middot; <%= pluralize(@register.length, "department") %></p>
  </header>

  <div class="inst-body">
    <nav class="inst-rail" aria-label="Contents" data-institute-rail>
      <p class="inst-rail__title">Contents</p>
      <ol class="inst-rail__list">
        <li><a class="inst-rail__link" href="#statement"><span class="inst-rail__number">1</span>The statement</a></li>
        <li><a class="inst-rail__link" href="#departments"><span class="inst-rail__number">2</span>Departments</a></li>
        <li><a class="inst-rail__link" href="#catalogue"><span class="inst-rail__number">3</span>The catalogue</a></li>
        <li><a class="inst-rail__link" href="#library"><span class="inst-rail__number">4</span>The library</a></li>
        <li><a class="inst-rail__link" href="#standards"><span class="inst-rail__number">5</span>Standards</a></li>
        <li><a class="inst-rail__link" href="#contact"><span class="inst-rail__number">6</span>Contact</a></li>
      </ol>
    </nav>

    <article class="inst-sheet">
      <section class="inst-clause" id="statement" data-institute-clause>
        <div class="inst-clause__head">
          <p class="inst-clause__number">1</p>
          <h1 class="inst-statement">Everything we sell has a materials list, and everything we publish has a source.</h1>
        </div>
        <p class="inst-standing">
          We are a shop and a publisher. The shop carries a small catalogue of sexual health and
          wellness products, chosen against written standards rather than a supplier's margin.
          The publisher carries the education that explains them, with the sources attached.
        </p>
        <p class="inst-standing">
          Nothing here is a medical claim, and nothing is invented to fill a page. Where a question
          is clinical, the library says so and points you to a clinician.
        </p>
        <p class="inst-note">
          The shop is published twice. This is the first: an annual report, one page per section,
          every heading numbered. <%= link_to "The folio", folio_path %> is the second, and it
          reads the whole shop as one continuous document.
        </p>
      </section>

      <section class="inst-clause" id="departments" data-institute-clause>
        <div class="inst-clause__head">
          <p class="inst-clause__number">2</p>
          <h2 class="inst-clause__title">Departments</h2>
        </div>
        <p class="inst-clause__standfirst">
          The register, in the order the shop keeps it. The count is what is actually available
          today, not what a supplier says might be.
        </p>

        <ol class="inst-register">
          <% @register.each do |category| %>
            <li>
              <%= link_to category_path(category), class: "inst-register__row" do %>
                <span class="inst-register__name"><%= category.name %></span>
                <span class="inst-register__count"><%= pluralize(category.catalogue_count, "object") %></span>
              <% end %>
            </li>
          <% end %>
        </ol>

        <div class="inst-actions">
          <%= link_to "Shop the catalogue", shop_path, class: "inst-button" %>
          <%= link_to "Everything we publish", learn_path, class: "inst-link" %>
        </div>
      </section>

      <section class="inst-clause" id="catalogue" data-institute-clause>
        <div class="inst-clause__head">
          <p class="inst-clause__number">3</p>
          <h2 class="inst-clause__title">The catalogue</h2>
        </div>
        <p class="inst-clause__standfirst">
          The most recent entries. Each object has one page, and that page carries its
          specifications before its description.
        </p>

        <ol class="inst-ledger">
          <% @featured.each do |product| %>
            <li>
              <%= link_to product_path(product.primary_category, product), class: "inst-ledger__row" do %>
                <span class="inst-ledger__plate"><%= product_cover_tag(product) %></span>
                <span>
                  <span class="inst-ledger__name"><%= product.name %></span>
                  <span class="inst-ledger__meta">
                    <%= product.primary_category&.name || "Catalogue" %>
                    <% if product.brand %> &middot; <%= product.brand.name %><% end %>
                  </span>
                </span>
                <span class="inst-ledger__price"><%= price(product.lowest_price_cents) %></span>
              <% end %>
            </li>
          <% end %>
        </ol>

        <div class="inst-actions">
          <%= link_to "All objects", shop_path, class: "inst-link" %>
        </div>
      </section>

      <section class="inst-clause" id="library" data-institute-clause>
        <div class="inst-clause__head">
          <p class="inst-clause__number">4</p>
          <h2 class="inst-clause__title">The library</h2>
        </div>
        <p class="inst-clause__standfirst">
          The education side of the shop. Each piece carries its sources, and each writer carries
          their credentials.
        </p>

        <% if @library.any? %>
          <ul class="inst-reading-list">
            <% @library.each do |article| %>
              <% topic = article.primary_topic || article.topics.first %>
              <li class="inst-reading-list__item">
                <%= link_to article.title,
                      topic ? learn_article_path(topic.slug, article.slug) : learn_path,
                      class: "inst-reading-list__title" %>
                <p class="inst-reading-list__meta">
                  <%= article.kind %>
                  <% if article.author %> &middot; <%= article.author.name %><% end %>
                  <% if article.published_at %> &middot; <%= article.published_at.strftime("%B %Y") %><% end %>
                </p>
              </li>
            <% end %>
          </ul>
          <div class="inst-actions">
            <%= link_to "The whole library", learn_path, class: "inst-link" %>
          </div>
        <% else %>
          <p class="inst-standing">The library is being prepared. Nothing is invented to fill it while it is.</p>
        <% end %>
      </section>

      <section class="inst-clause" id="standards" data-institute-clause>
        <div class="inst-clause__head">
          <p class="inst-clause__number">5</p>
          <h2 class="inst-clause__title">Standards</h2>
        </div>
        <p class="inst-clause__standfirst">
          Three undertakings, applied to every object in the catalogue and every piece in the library.
        </p>

        <ol class="inst-undertakings">
          <li class="inst-undertaking">
            <p class="inst-undertaking__number">5.1</p>
            <h3 class="inst-undertaking__title">How we choose what we stock</h3>
            <p class="inst-undertaking__body">
              Materials are declared, body-safe claims are checked against them, and a supplier that
              will not state either is not stocked.
            </p>
          </li>
          <li class="inst-undertaking">
            <p class="inst-undertaking__number">5.2</p>
            <h3 class="inst-undertaking__title">What arrives, and what it says on it</h3>
            <p class="inst-undertaking__body">
              Plain packaging, no product name on the outside, and a billing line that names this
              company and nothing else.
            </p>
          </li>
          <li class="inst-undertaking">
            <p class="inst-undertaking__number">5.3</p>
            <h3 class="inst-undertaking__title">What we collect, and what we refuse to</h3>
            <p class="inst-undertaking__body">
              No analytics, no ad pixels, no session recording. Purchase history reveals health
              intent, and it is treated as sensitive even though this is not a clinic.
            </p>
          </li>
          <li class="inst-undertaking">
            <p class="inst-undertaking__number">5.4</p>
            <h3 class="inst-undertaking__title">What we will not write</h3>
            <p class="inst-undertaking__body">
              No medical claims, no invented statistics, no citation to a study that does not
              exist. A missing fact stays missing until it can be sourced.
            </p>
          </li>
        </ol>
      </section>

      <section class="inst-clause" id="contact" data-institute-clause>
        <div class="inst-clause__head">
          <p class="inst-clause__number">6</p>
          <h2 class="inst-clause__title">Contact</h2>
        </div>
        <p class="inst-standing">
          Questions about an object, an order, or something we published:
          <%= mail_to Store.support_email, Store.support_email, class: "inst-link" %>.
        </p>
        <div class="inst-actions">
          <%= link_to "About", page_path("about"), class: "inst-link" %>
          <%= link_to "Standards", page_path("standards"), class: "inst-link" %>
          <%= link_to "Shipping", page_path("shipping"), class: "inst-link" %>
          <%= link_to "Privacy", page_path("privacy"), class: "inst-link" %>
          <%= link_to "FAQ", page_path("faq"), class: "inst-link" %>
        </div>
      </section>
    </article>
  </div>
</div>
