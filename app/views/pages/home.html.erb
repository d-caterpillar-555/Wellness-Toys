<% content_for :title, nil %>
<% content_for :meta_description, "#{Store.name} sells sexual health and wellness products, and publishes the education that explains them. Evidence over euphemism, discretion as standard." %>

<%# Position 2: the index.
    The front page opens as the contents page of the archive: the register of
    departments first, the specimens after it. The shop's own words arrive
    once the reader has seen what is actually here. %>
<div class="v2-world" data-style="darkroom" data-variate-section="home-html">
  <style nonce="<%= content_security_policy_nonce %>">
    .v2-world {
      background-color: var(--color-paper);
      color: var(--color-body);
      min-block-size: 100dvh;
    }

    /* A masthead band, not a kicker over the heading: the two ends of one
       rule, with the statement starting clean underneath it. */
    .v2-band {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: calc(var(--spacing) * 4);
      padding-block: calc(var(--spacing) * 4);
      border-block-end: 1px solid var(--color-line);
    }

    .v2-masthead {
      display: grid;
      gap: calc(var(--spacing) * 6);
      padding-block: calc(var(--spacing) * 10) calc(var(--spacing) * 10);
    }

    .v2-statement {
      font-size: clamp(2.25rem, 5vw, 3.5rem);
      line-height: 1.05;
      letter-spacing: var(--tracking-display);
      max-width: 28ch;
    }

    .v2-indices {
      display: grid;
      gap: calc(var(--spacing) * 10);
    }

    @media (min-width: 900px) {
      .v2-indices {
        grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
        gap: calc(var(--spacing) * 16);
      }
    }

    .v2-heading {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: calc(var(--spacing) * 4);
      padding-block-end: calc(var(--spacing) * 3);
      border-block-end: 1px solid var(--color-line);
    }

    .v2-strip {
      display: flex;
      gap: calc(var(--spacing) * 6);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-block: calc(var(--spacing) * 8);
    }

    .v2-strip > li {
      flex: 0 0 auto;
      inline-size: 14rem;
      scroll-snap-align: start;
    }
  </style>

  <div class="v2-band">
    <p class="wt-register"><%= Store.name %></p>
    <p class="wt-register">
      <%= pluralize(@register.sum(&:catalogue_count), "product") %>
      across <%= pluralize(@register.size, "department") %>
      · discreet shipping
      · billed as <%= Store.legal_entity %>
    </p>
  </div>

  <section class="wt-container v2-masthead">
    <h1 class="v2-statement text-ink">
      Everything we sell has a materials list, and everything we publish has a source.
    </h1>
    <p class="max-w-[58ch] text-lede">
      Products we can explain, and an education library we cite. No euphemisms, no shame, and no guessing.
    </p>
  </section>

  <section class="wt-container pb-16">
    <div class="v2-indices">
      <div>
        <div class="v2-heading">
          <h2 class="text-heading text-ink">Departments</h2>
          <%= link_to "Shop the catalogue", shop_path, class: "wt-btn wt-btn--quiet" %>
        </div>
        <ul>
          <% @register.each do |category| %>
            <li>
              <%= link_to category_path(category), class: "wt-index-row" do %>
                <span class="wt-index-row__label"><%= category.name %></span>
                <span class="wt-leader" aria-hidden="true"></span>
                <span class="wt-index-row__data wt-register"><%= pluralize(category.catalogue_count, "product") %></span>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>

      <div>
        <div class="v2-heading">
          <h2 class="text-heading text-ink">The library</h2>
          <%= link_to "Read", learn_path, class: "wt-btn wt-btn--quiet" %>
        </div>
        <ul>
          <li>
            <%= link_to learn_path, class: "wt-index-row" do %>
              <span class="wt-index-row__label">Guides and explainers</span>
              <span class="wt-leader" aria-hidden="true"></span>
              <span class="wt-index-row__data wt-register">Learn</span>
            <% end %>
          </li>
          <li>
            <%= link_to learn_glossary_path, class: "wt-index-row" do %>
              <span class="wt-index-row__label">Glossary of terms</span>
              <span class="wt-leader" aria-hidden="true"></span>
              <span class="wt-index-row__data wt-register">Terms</span>
            <% end %>
          </li>
          <li>
            <%= link_to learn_experts_path, class: "wt-index-row" do %>
              <span class="wt-index-row__label">Who writes it</span>
              <span class="wt-leader" aria-hidden="true"></span>
              <span class="wt-index-row__data wt-register">Writers</span>
            <% end %>
          </li>
          <li>
            <%= link_to blog_path, class: "wt-index-row" do %>
              <span class="wt-index-row__label">The blog</span>
              <span class="wt-leader" aria-hidden="true"></span>
              <span class="wt-index-row__data wt-register">Posts</span>
            <% end %>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <% if @featured.any? %>
    <section class="border-block-start border-line">
      <div class="wt-container pt-12">
        <div class="v2-heading">
          <h2 class="text-heading text-ink">Recent specimens</h2>
          <%= link_to "All products", shop_path, class: "wt-btn wt-btn--quiet" %>
        </div>

        <ul class="v2-strip">
          <% @featured.each do |product| %>
            <li>
              <%= render "products/specimen", product: product, category: product.primary_category %>
            </li>
          <% end %>
        </ul>
      </div>
    </section>
  <% end %>

  <section class="border-block-start border-line">
    <div class="wt-container grid gap-10 py-20 md:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)] md:gap-16">
      <h2 class="text-heading text-ink max-w-[18ch]">Most of this industry talks to you like a joke.</h2>
      <div class="wt-prose">
        <p>
          Open a typical shop in this category and you get black backgrounds, neon
          glow, and product names that are embarrassed by their own subject. The
          information you actually need is buried under the winking.
        </p>
        <p>
          So we started from the other direction. Everything we sell has a
          materials list, care instructions and dimensions. Everything we publish
          has a source. Where a question is medical, we say so and point you at a
          clinician instead of quietly implying a product will fix it.
        </p>
        <p>
          That is the whole idea. Treat people as adults, and treat the subject
          the way any other part of health gets treated.
        </p>
      </div>
    </div>
  </section>

  <section class="border-block-start border-line bg-paper-sunk">
    <div class="wt-container py-20">
      <h2 class="text-heading text-ink mb-12 max-w-[24ch]">Three things we will not do</h2>
      <dl class="grid max-w-[76rem] gap-x-16 gap-y-10 md:grid-cols-2">
        <div class="border-block-start border-line pt-6">
          <dt class="mb-3 text-title text-ink font-display">We will not invent facts.</dt>
          <dd class="max-w-[46ch] text-body">
            No made up statistics, no borrowed credentials, no studies that do not exist. If we cite something, you can follow the link and read it.
          </dd>
        </div>
        <div class="border-block-start border-line pt-6">
          <dt class="mb-3 text-title text-ink font-display">We will not make medical claims.</dt>
          <dd class="max-w-[46ch] text-body">
            A product can be described accurately without pretending to be a treatment. Anything clinical belongs with a clinician.
          </dd>
        </div>
        <div class="border-block-start border-line pt-6">
          <dt class="mb-3 text-title text-ink font-display">We will not sell your privacy.</dt>
          <dd class="max-w-[46ch] text-body">
            Purchase history and browsing in this category reveal health intent. No advertising trackers, no session recording, and nothing in a URL that identifies you.
          </dd>
        </div>
        <div class="border-block-start border-line pt-6">
          <dt class="mb-3 text-title text-ink font-display">We will not pretend to be discreet.</dt>
          <dd class="max-w-[46ch] text-body">
            Plain packaging and a neutral billing descriptor, stated once, on the shipping page. It is a standard we meet, not a slogan we shout.
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="border-block-start border-line">
    <div class="wt-container py-20">
      <ul>
        <li>
          <%= link_to page_path("standards"), class: "wt-index-row" do %>
            <span class="wt-index-row__label">How we choose what we stock</span>
            <span class="wt-leader" aria-hidden="true"></span>
            <span class="wt-index-row__data wt-register">Standards</span>
          <% end %>
        </li>
        <li>
          <%= link_to page_path("discreet-shipping"), class: "wt-index-row" do %>
            <span class="wt-index-row__label">What arrives, and what it says on it</span>
            <span class="wt-leader" aria-hidden="true"></span>
            <span class="wt-index-row__data wt-register">Shipping</span>
          <% end %>
        </li>
        <li>
          <%= link_to page_path("privacy"), class: "wt-index-row" do %>
            <span class="wt-index-row__label">What we collect, and what we refuse to</span>
            <span class="wt-leader" aria-hidden="true"></span>
            <span class="wt-index-row__data wt-register">Privacy</span>
          <% end %>
        </li>
      </ul>
    </div>
  </section>
</div>
