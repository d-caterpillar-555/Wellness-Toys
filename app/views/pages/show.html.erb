<% content_for :title, @page.meta_title.presence || @page.title %>
<% content_for :meta_description, @page.meta_description.presence || @page.subtitle %>

<article class="wt-container py-16 md:py-24">
  <header class="max-w-[68ch] mb-12 md:mb-16">
    <h1 class="text-display-sm md:text-display text-ink"><%= @page.title %></h1>
    <% if @page.subtitle.present? %>
      <p class="mt-6 text-lede text-body"><%= @page.subtitle %></p>
    <% end %>
  </header>

  <div class="wt-prose">
    <% @page.paragraphs.each do |paragraph| %>
      <p><%= paragraph %></p>
    <% end %>
  </div>
</article>
