<% content_for :title, @article.title %>
<% content_for :meta_description, @article.excerpt.presence || "An article from the #{Store.name} education library." %>

<% trail = [ [ "Learn", learn_path ] ] %>
<% trail << [ @topic.name, learn_topic_path(@topic) ] if @topic %>
<% trail << [ @article.title, request.path ] %>

<% content_for :structured_data do %>
  <%= json_ld(breadcrumb_schema(trail)) %>
  <%= json_ld(article_schema(@article)) %>
<% end %>

<div class="inst">
  <header class="inst-run">
    <p class="inst-run__mark"><%= link_to Store.name, root_path, class: "inst-link" %></p>
    <p class="inst-run__section">
      <%= link_to "Library", learn_path, class: "inst-link" %>
      <% if @topic %> &middot; <%= link_to @topic.name, learn_topic_path(@topic), class: "inst-link" %><% end %>
    </p>
    <p><%= @article.kind %></p>
  </header>

  <div class="inst-body">
    <nav class="inst-rail" aria-label="Contents" data-institute-rail>
      <p class="inst-rail__title">Contents</p>
      <ol class="inst-rail__list">
        <li><a class="inst-rail__link" href="#piece"><span class="inst-rail__number">1</span>The piece</a></li>
        <li><a class="inst-rail__link" href="#sources"><span class="inst-rail__number">2</span>Sources</a></li>
      </ol>
    </nav>

    <article class="inst-sheet">
      <section class="inst-clause" id="piece" data-institute-clause>
        <div class="inst-clause__head">
          <p class="inst-clause__number">1</p>
          <h1 class="inst-clause__title"><%= @article.title %></h1>
        </div>

        <p class="inst-reading-list__meta">
          <% if @article.author %>
            <%= link_to @article.author.name, learn_expert_path(@article.author), class: "inst-link" %>
            <% if @article.author.credentials.present? %> &middot; <%= @article.author.credentials %><% end %>
            &middot;
          <% end %>
          <% if @article.published_at %><%= @article.published_at.strftime("%d %B %Y") %> &middot; <% end %>
          <%= reading_time(@article) %>
        </p>

        <% if @article.excerpt.present? %>
          <p class="inst-clause__standfirst inst-record__sub"><%= @article.excerpt %></p>
        <% end %>

        <div class="inst-prose">
          <%= simple_format(@article.body) %>
        </div>
      </section>

      <section class="inst-clause" id="sources" data-institute-clause>
        <div class="inst-clause__head">
          <p class="inst-clause__number">2</p>
          <h2 class="inst-clause__title"<% if @article.sources.any? %> id="sources-heading"<% end %>>Sources</h2>
        </div>

        <% if @article.sources.any? %>
          <p class="inst-clause__standfirst">
            What this piece rests on. Where nothing could be sourced, the claim was left out.
          </p>
          <ol class="inst-reading-list">
            <% @article.sources.each do |source| %>
              <li class="inst-reading-list__item">
                <p class="inst-review__title"><%= source.title %></p>
                <p class="inst-reading-list__meta">
                  <%= [ source.publisher, source.published_on&.year ].compact.join(", ") %>
                  &middot; <%= link_to "Read it", source.url, class: "inst-link", rel: "noopener noreferrer", target: "_blank" %>
                </p>
              </li>
            <% end %>
          </ol>
        <% else %>
          <p class="inst-standing">This piece does not cite external sources.</p>
        <% end %>
      </section>

      <% if @related.any? %>
        <section class="inst-clause" id="related" data-institute-clause>
          <div class="inst-clause__head">
            <p class="inst-clause__number">3</p>
            <h2 class="inst-clause__title">Related</h2>
          </div>
          <ul class="inst-reading-list">
            <% @related.each do |article| %>
              <% topic = article.primary_topic || article.topics.first %>
              <li class="inst-reading-list__item">
                <%= link_to article.title,
                      topic ? learn_article_path(topic.slug, article.slug) : learn_path,
                      class: "inst-reading-list__title" %>
              </li>
            <% end %>
          </ul>
        </section>
      <% end %>
    </article>
  </div>
</div>
