<%# locals: (article:) %>
<%# One article, wherever it is listed. Posts link to the blog; anything else
    links through its primary topic. When neither is available the same content
    renders unlinked, so a card is never a dead end. %>
<% path = article_link_path(article) %>
<% primary_topic = article.primary_topic %>

<% content = capture do %>
  <p class="flex flex-wrap items-baseline gap-x-2 text-caption text-muted">
    <span><%= kind_label(article) %></span>
    <% if primary_topic %>
      <span aria-hidden="true">/</span>
      <span><%= primary_topic.name %></span>
    <% end %>
  </p>

  <h3 class="mt-2 text-title text-ink group-hover:text-accent"><%= article.title %></h3>

  <% if article.excerpt.present? %>
    <p class="mt-3 text-body"><%= article.excerpt %></p>
  <% end %>

  <p class="mt-4 text-caption text-muted"><%= article_meta(article) %></p>
<% end %>

<article class="group">
  <% if path %>
    <%= link_to content, path, class: "block no-underline" %>
  <% else %>
    <%= content %>
  <% end %>
</article>
