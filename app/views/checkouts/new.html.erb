<% content_for :title, t("checkout.title") %>
<% content_for :meta_description, t("checkout.intro") %>

<section class="wt-container py-12 md:py-16">
  <div class="max-w-[34rem]">
    <h1 class="text-display-sm text-ink md:text-display"><%= t("checkout.title") %></h1>
    <p class="mt-4 text-lede text-body"><%= t("checkout.intro") %></p>

    <% if @order.errors.any? %>
      <div class="wt-panel mt-8 px-5 py-4" role="alert">
        <p class="text-ui text-ink"><%= t("checkout.errors_heading") %></p>
      </div>
    <% end %>

    <%= form_with model: @order, scope: :checkout, url: checkout_path, method: :post, class: "mt-10 space-y-6" do |form| %>
      <%= form.hidden_field :checkout_token %>

      <%= render "shared/field", form: form, attribute: :email, label: t("checkout.fields.email"), type: :email_field, autocomplete: "email", hint: t("checkout.hints.email") %>
      <%= render "shared/field", form: form, attribute: :ship_to_recipient, label: t("checkout.fields.recipient"), autocomplete: "name" %>
      <%= render "shared/field", form: form, attribute: :ship_to_line1, label: t("checkout.fields.line1"), autocomplete: "address-line1" %>
      <%= render "shared/field", form: form, attribute: :ship_to_line2, label: t("checkout.fields.line2"), autocomplete: "address-line2" %>
      <%= render "shared/field", form: form, attribute: :ship_to_city, label: t("checkout.fields.city"), autocomplete: "address-level2" %>
      <%= render "shared/field", form: form, attribute: :ship_to_region, label: t("checkout.fields.region"), autocomplete: "address-level1" %>
      <%= render "shared/field", form: form, attribute: :ship_to_postal_code, label: t("checkout.fields.postal_code"), autocomplete: "postal-code" %>
      <%= render "shared/field", form: form, attribute: :ship_to_country_code, label: t("checkout.fields.country_code"), autocomplete: "country", hint: t("checkout.hints.country_code") %>

      <div class="pt-2">
        <%= form.submit t("checkout.submit"), class: "wt-btn wt-btn--primary w-full" %>
        <p class="wt-hint"><%= t("checkout.trust") %></p>
      </div>
    <% end %>
  </div>
</section>
