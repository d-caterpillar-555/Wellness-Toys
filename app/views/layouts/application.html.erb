<!DOCTYPE html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title><%= content_for(:title).presence || Store.title_for(nil) %></title>
    <meta name="description" content="<%= content_for(:meta_description).presence || Store.tagline %>">

    <%# Self-referencing canonical. Override per page only when a different
        canonical is genuinely correct. %>
    <link rel="canonical" href="<%= content_for(:canonical).presence || request.base_url + request.path %>">

    <meta property="og:site_name" content="<%= Store.name %>">
    <meta property="og:title" content="<%= content_for(:title).presence || Store.title_for(nil) %>">
    <meta property="og:description" content="<%= content_for(:meta_description).presence || Store.tagline %>">
    <meta property="og:type" content="<%= content_for(:og_type).presence || "website" %>">
    <meta property="og:url" content="<%= request.base_url + request.path %>">
    <% if content_for?(:og_image) %>
      <meta property="og:image" content="<%= content_for(:og_image) %>">
    <% end %>

    <meta name="twitter:card" content="summary_large_image">
    <meta name="theme-color" content="#F5F4F0" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#12151A" media="(prefers-color-scheme: dark)">

    <%# Turbo drives same-origin view transitions where the browser has the API,
        so a navigation turns over instead of flashing between documents. %>
    <meta name="view-transition" content="same-origin">

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Only the two weights used above the fold are preloaded. %>
    <link rel="preload" href="/fonts/newsreader-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/instrument-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>

    <%# tailwindcss-rails builds app/assets/tailwind/application.css into
        app/assets/builds/tailwind.css: the baseline components that the
        transactional pages and the institute world share. %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%# institute is the store's own sheet. The folio loads its own in its own
        layout. %>
    <%= stylesheet_link_tag "worlds/institute", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= javascript_import_module_tag "worlds/institute" %>

    <%# Resolve the theme before first paint so nobody sees a flash of the wrong
        one. Inline and nonce-signed on purpose: an external request here would
        defeat the point. %>
    <script nonce="<%= content_security_policy_nonce %>">
      (function () {
        try {
          var stored = localStorage.getItem("wt-theme");
          var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          document.documentElement.dataset.theme = stored || (prefersDark ? "dark" : "light");
        } catch (e) {
          document.documentElement.dataset.theme = "light";
        }
      })();
    </script>

    <%# The publisher and the site, as one server-rendered graph. A page adds its
        own subject (a product, an article, a writer) through
        content_for :structured_data. %>
    <%= json_ld(organization_schema) %>
    <%= json_ld(website_schema) %>
    <%= yield :structured_data %>
  </head>

  <body class="min-h-[100dvh] flex flex-col bg-paper text-body">
    <a href="#main" class="wt-skip-link">Skip to content</a>

    <%# One prompt at a time: the age acknowledgement first, consent once that is
        answered. Both are recorded in the visitor's own session and neither
        blocks the page. %>
    <%= render "shared/age_gate" unless age_confirmed? %>
    <%= render "shared/consent_banner" if age_confirmed? && !consent_decided? %>

    <%= render "layouts/header" %>

    <main id="main" class="flex-1">
      <%= render "layouts/flash" %>
      <%= yield %>
    </main>

    <%= render "layouts/footer" %>
  </body>
</html>
