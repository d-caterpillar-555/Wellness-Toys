<%# The world switch. Four worlds, all visible, the live one marked. Each carries
    its backstory as a title so a reader who wants to know why the shop looks
    like this can find out without leaving the page. %>
<nav class="wt-style-switch" aria-label="Visual style" data-controller="style">
  <button type="button" class="wt-style-switch__option" data-style-target="option" data-style-name="tidewater"
          data-action="style#apply" aria-pressed="true"
          title="Tidewater: the lightkeeper's logbook, 1911. Salt-bleached chart paper, channel ink, one signal orange. The catalogue is read as a manifest.">
    Tidewater
  </button>
  <button type="button" class="wt-style-switch__option" data-style-target="option" data-style-name="solarium"
          data-action="style#apply" aria-pressed="false"
          title="Solarium: a sanatorium's south wing, 1968. Chalk, graphite, one enamel blue, painted rules. Nothing sold here that cannot be photographed honestly at noon. No motion at all.">
    Solarium
  </button>
  <button type="button" class="wt-style-switch__option" data-style-target="option" data-style-name="studio"
          data-action="style#apply" aria-pressed="false"
          title="Studio B: a converted bakery, 1983. Tape black and silver, one hot magenta, halftone photographs printed out of register. Wow and flutter.">
    Studio B
  </button>
  <button type="button" class="wt-style-switch__option" data-style-target="option" data-style-name="herbarium"
          data-action="style#apply" aria-pressed="false"
          title="Herbarium: a dispensary that pressed, mounted and labelled every preparation. Linen paper, moss ink, one deep berry. Sheets that settle into place.">
    Herbarium
  </button>
</nav>
