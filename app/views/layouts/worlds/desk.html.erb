<!DOCTYPE html>
<html lang="en" data-theme="light">
  <head>
    <%= render "layouts/world_head", stylesheet: "worlds/desk", module_name: "worlds/desk" %>
  </head>

  <body class="desk">
    <a class="desk-skip" href="#main">Skip to content</a>

    <%= render "shared/age_gate" unless age_confirmed? %>
    <%= render "shared/consent_banner" if age_confirmed? && !consent_decided? %>

    <header class="desk-masthead">
      <p class="desk-wordmark"><%= link_to Store.name, desk_path %></p>
      <nav aria-label="Sections">
        <ul class="desk-masthead__links">
          <li><%= link_to "The desk", desk_path, class: "desk-masthead__link", aria: { current: ("page" if current_page?(desk_path)) } %></li>
          <li><%= link_to "The shelf", desk_shelf_path, class: "desk-masthead__link", aria: { current: ("page" if current_page?(desk_shelf_path)) } %></li>
          <li><%= link_to "The library", learn_path, class: "desk-masthead__link" %></li>
          <li><%= link_to "The shop", root_path, class: "desk-masthead__link" %></li>
        </ul>
      </nav>
    </header>

    <%= yield %>

    <%= render "shared/world_dock" %>
  </body>
</html>
