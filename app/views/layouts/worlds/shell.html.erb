<!DOCTYPE html>
<html lang="en" data-theme="light">
  <head>
    <%= render "layouts/world_head", stylesheet: "worlds/shell", module_name: "worlds/shell" %>
  </head>

  <%# A machine, not a page. The theme script still runs, but this world paints
      its own surface and ignores the light/dark tokens on purpose. %>
  <body class="shell">
    <a class="shell-skip" href="#main">Skip to content</a>

    <%= render "shared/age_gate" unless age_confirmed? %>
    <%= render "shared/consent_banner" if age_confirmed? && !consent_decided? %>

    <%= yield %>

    <%= render "shared/world_dock" %>
  </body>
</html>
