<% content_for :title, t("account.addresses.title") %>

<section class="wt-container py-12 md:py-16">
  <h1 class="text-display-sm text-ink md:text-display"><%= t("account.addresses.title") %></h1>
  <p class="mt-4 max-w-[52ch] text-lede text-body"><%= t("account.addresses.intro") %></p>

  <div class="mt-10">
    <%= render "account/nav" %>
  </div>

  <% if @addresses.any? %>
    <ul class="mt-12 border-t border-line">
      <% @addresses.each do |address| %>
        <li class="flex flex-wrap items-start justify-between gap-x-8 gap-y-4 border-b border-line py-6">
          <div class="max-w-[36ch]">
            <p class="text-ui text-ink">
              <%= address.recipient %>
              <% if address.label.present? %>
                <span class="text-caption text-muted"> / <%= address.label %></span>
              <% end %>
            </p>
            <p class="mt-1 text-caption text-muted"><%= address.one_line %></p>
            <p class="mt-2 flex flex-wrap gap-2">
              <% if address.default_shipping? %>
                <span class="wt-badge"><%= t("account.addresses.default_shipping") %></span>
              <% end %>
              <% if address.default_billing? %>
                <span class="wt-badge"><%= t("account.addresses.default_billing") %></span>
              <% end %>
            </p>
          </div>

          <div class="flex items-center gap-3">
            <%= link_to t("account.addresses.edit"), edit_account_address_path(address), class: "wt-btn wt-btn--secondary" %>
            <%= button_to t("account.addresses.remove"), account_address_path(address), method: :delete, class: "wt-btn wt-btn--quiet" %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="mt-12 max-w-[52ch] border-t border-line pt-8">
      <p class="text-lede text-ink"><%= t("account.addresses.empty") %></p>
    </div>
  <% end %>

  <div class="mt-8">
    <%= link_to t("account.addresses.add"), new_account_address_path, class: "wt-btn wt-btn--primary" %>
  </div>
</section>
