<% content_for :title, t("account.data_requests.title") %>

<section class="wt-container py-12 md:py-16">
  <h1 class="text-display-sm text-ink md:text-display"><%= t("account.data_requests.title") %></h1>
  <p class="mt-4 max-w-[52ch] text-lede text-body"><%= t("account.data_requests.intro") %></p>

  <div class="mt-10">
    <%= render "account/nav" %>
  </div>

  <% if @requests.any? %>
    <ul class="mt-12 border-t border-line">
      <% @requests.each do |request| %>
        <li class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-2 border-b border-line py-5">
          <div>
            <p class="text-ui text-ink"><%= t("account.data_requests.kinds.#{request.kind}") %></p>
            <p class="mt-1 text-caption text-muted tnum"><%= request.requested_at.utc.strftime("%-d %B %Y") %></p>
          </div>
          <span class="wt-badge"><%= t("account.data_requests.statuses.#{request.status}") %></span>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="mt-12 max-w-[52ch] border-t border-line pt-8">
      <p class="text-lede text-ink"><%= t("account.data_requests.empty") %></p>
    </div>
  <% end %>

  <p class="mt-8 max-w-[52ch] text-caption text-muted"><%= t("account.data_requests.retention_note") %></p>

  <div class="mt-8">
    <%= link_to t("account.data_requests.new_title"), new_account_data_request_path, class: "wt-btn wt-btn--secondary" %>
  </div>
</section>
