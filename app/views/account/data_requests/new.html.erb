<% content_for :title, t("account.data_requests.new_title") %>

<section class="wt-container py-12 md:py-16">
  <div class="max-w-[34rem]">
    <h1 class="text-display-sm text-ink md:text-display"><%= t("account.data_requests.new_title") %></h1>
    <p class="mt-4 text-lede text-body"><%= t("account.data_requests.new_intro") %></p>

    <%= render "shared/form_errors", resource: @request %>

    <%= form_with model: @request, url: account_data_requests_path, class: "mt-10" do |form| %>
      <fieldset class="space-y-4">
        <legend class="wt-label"><%= t("account.data_requests.new_title") %></legend>
        <% DataRequest::KINDS.each do |kind| %>
          <label class="flex items-start gap-3 text-body">
            <%= radio_button_tag "data_request[kind]", kind, @request.kind == kind, id: "data_request_kind_#{kind}" %>
            <span><%= t("account.data_requests.kinds.#{kind}") %></span>
          </label>
        <% end %>
      </fieldset>

      <div class="mt-8 flex flex-wrap gap-3 border-t border-line pt-6">
        <%= form.submit t("account.data_requests.submit"), class: "wt-btn wt-btn--primary" %>
        <%= link_to t("account.data_requests.back"), account_data_requests_path, class: "wt-btn wt-btn--quiet" %>
      </div>
    <% end %>
  </div>
</section>
