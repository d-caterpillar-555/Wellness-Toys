<% content_for :title, t("orders.show.title", number: @order.number) %>
<% content_for :meta_description, t("orders.show.eyebrow") %>

<section class="wt-container py-12 md:py-16">
  <div class="max-w-[52rem]">
    <%= link_to t("account.orders.back"), account_orders_path, class: "text-caption text-accent no-underline" %>

    <p class="mt-6 text-label text-muted"><%= t("orders.show.eyebrow") %></p>
    <h1 class="mt-2 text-display-sm text-ink"><%= @order.number %></h1>

    <div class="mt-4 flex flex-wrap items-center gap-3">
      <span class="wt-badge wt-badge--accent"><%= t("orders.status.#{@order.status}", default: @order.status.humanize) %></span>
      <span class="wt-badge"><%= t("orders.payment_status.#{@order.payment_status}", default: @order.payment_status.humanize) %></span>
    </div>

    <%= render "orders/detail", order: @order, items: @items, events: @events %>
  </div>
</section>
