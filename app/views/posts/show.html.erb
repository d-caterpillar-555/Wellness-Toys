<% content_for :title, @post.title %>
<% content_for :meta_description, @post.excerpt.presence || "A post from the #{Store.name} blog." %>

<article class="wt-container py-16 md:py-24">
  <nav aria-label="Breadcrumb" class="text-caption">
    <%= link_to "Blog", blog_path, class: "text-body no-underline hover:text-ink" %>
    <span aria-hidden="true" class="text-muted"> / </span>
    <span class="text-ink" aria-current="page"><%= @post.title %></span>
  </nav>

  <header class="mt-8 max-w-[68ch]" data-controller="reveal" data-reveal>
    <p class="text-label text-muted"><%= kind_label(@post) %></p>
    <h1 class="mt-3 text-display-sm text-ink md:text-display"><%= @post.title %></h1>

    <% if @post.excerpt.present? %>
      <p class="mt-6 text-lede text-body"><%= @post.excerpt %></p>
    <% end %>

    <p class="mt-6 text-caption text-muted"><%= article_meta(@post) %></p>
  </header>

  <div class="mt-12 grid gap-12 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-16">
    <div>
      <div class="wt-prose">
        <% @post.paragraphs.each do |paragraph| %>
          <p><%= paragraph %></p>
        <% end %>
      </div>

      <% if @post.sources.empty? %>
        <p class="mt-12 text-ui text-muted">This piece does not cite external sources.</p>
      <% end %>
    </div>

    <% if @post.sources.any? %>
      <aside class="lg:sticky lg:top-8 lg:self-start lg:border-l lg:border-line lg:pl-8">
        <%= render "articles/sources_rail", article: @post %>
      </aside>
    <% end %>
  </div>
</article>
