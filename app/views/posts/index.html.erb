<% content_for :title, "The blog" %>
<% content_for :meta_description, "Timely writing from #{Store.name}, separate from the evergreen library under Learn." %>

<section class="wt-container pt-12 pb-8 md:pt-16" data-controller="reveal" data-reveal>
  <nav aria-label="Breadcrumb" class="text-caption">
    <span class="text-ink" aria-current="page">Blog</span>
  </nav>

  <h1 class="mt-4 text-display-sm text-ink md:text-display">The blog</h1>
  <p class="mt-4 max-w-[60ch] text-lede text-body">
    Shorter and timelier than the guides, and dated because of it. The evergreen
    writing and the glossary live in the library under Learn.
  </p>
</section>

<section class="wt-container pb-20" data-controller="reveal" data-reveal>
  <% if @posts.any? %>
    <div class="grid gap-x-8 gap-y-10 md:grid-cols-2 lg:grid-cols-3">
      <% @posts.each do |post| %>
        <%= render "articles/card", article: post %>
      <% end %>
    </div>
    <%= render "shared/pagination", pagy: @pagy %>
  <% else %>
    <div class="max-w-[52ch] border-t border-line pt-8">
      <p class="text-lede text-ink">No posts yet.</p>
      <p class="mt-3 text-body">The blog carries timely writing rather than the evergreen guides. Those live in the library.</p>
      <%= link_to "Read the library", learn_path, class: "wt-btn wt-btn--secondary mt-6" %>
    </div>
  <% end %>
</section>
