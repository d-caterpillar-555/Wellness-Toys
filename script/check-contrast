#!/usr/bin/env ruby
# frozen_string_literal: true

# Contrast check for the storefront's architectures.
#
# The default architecture (institute) is built on the design system's tokens in
# app/assets/tailwind/application.css, so those are checked where they are
# declared. Every other world declares its own palette at the top of its own
# stylesheet as --w-* custom properties in OKLCH; those are checked per world.
#
# Run it after touching any palette:
#
#   bin/rails runner script/check-contrast
#
# It reads the stylesheets as text rather than through a browser, so it runs in
# CI without a display and without a build step.

BASE_STYLESHEET = Rails.root.join("app/assets/tailwind/application.css")
WORLD_STYLESHEETS = Rails.root.glob("app/assets/stylesheets/worlds/*.css").sort

CHECKS = [
  [ "body on surface", "body", "surface", 4.5 ],
  [ "ink on surface", "ink", "surface", 4.5 ],
  [ "muted on surface", "muted", "surface", 4.5 ],
  [ "accent on surface", "accent", "surface", 4.5 ],
  [ "on-accent on accent", "on-accent", "accent", 4.5 ]
].freeze

# The design system's token names, for the base sheet.
BASE_CHECKS = [
  [ "body on paper", "body", "paper", 4.5 ],
  [ "ink on paper", "ink", "paper", 4.5 ],
  [ "muted on paper", "muted", "paper", 4.5 ],
  [ "accent on paper", "accent", "paper", 4.5 ],
  [ "on-accent on accent-strong", "on-accent", "accent-strong", 4.5 ]
].freeze

def tokens_in(css, prefix)
  css.scan(/--#{prefix}([a-z0-9-]+):\s*oklch\(([^)]+)\)/).to_h do |name, raw|
    lightness, chroma, hue = raw.delete("%").split.map(&:to_f)
    [ name, [ lightness / 100.0, chroma, hue ] ]
  end
end

# oklch to linear sRGB to relative luminance, per WCAG.
def luminance(lightness, chroma, hue_degrees)
  hue = hue_degrees * Math::PI / 180
  a = chroma * Math.cos(hue)
  b = chroma * Math.sin(hue)

  l_ = lightness + (0.3963377774 * a) + (0.2158037573 * b)
  m_ = lightness - (0.1055613458 * a) - (0.0638541728 * b)
  s_ = lightness - (0.0894841775 * a) - (1.2914855480 * b)

  l = l_**3
  m = m_**3
  s = s_**3

  red = (4.0767416621 * l) - (3.3077115913 * m) + (0.2309699292 * s)
  green = (-1.2684380046 * l) + (2.6097574011 * m) - (0.3413193965 * s)
  blue = (-0.0041960863 * l) - (0.7034186147 * m) + (1.7076147010 * s)

  [ red, green, blue ].map { |value| value.clamp(0.0, 1.0) }.then do |r, g, b|
    (0.2126 * r) + (0.7152 * g) + (0.0722 * b)
  end
end

def ratio(tokens, foreground, background)
  a = luminance(*tokens.fetch(foreground))
  b = luminance(*tokens.fetch(background))
  high, low = [ a, b ].max, [ a, b ].min
  (high + 0.05) / (low + 0.05)
end

def check(label, css, prefix, pairs, failures)
  tokens = tokens_in(css, prefix)
  return if tokens.empty?

  puts "--- #{label} ---"

  pairs.each do |description, foreground, background, floor|
    next unless tokens.key?(foreground) && tokens.key?(background)

    value = ratio(tokens, foreground, background)
    verdict = value >= floor ? "ok" : "BELOW"
    failures << "#{label}: #{description} #{format('%.2f', value)} < #{floor}" if value < floor
    puts format("  %-28s %5.2f:1  floor %.1f  %s", description, value, floor, verdict)
  end
end

failures = []

base_css = BASE_STYLESHEET.read
# Only the light-mode declarations: the dark block later in the file redeclares the
# same names, and a scan that took the last value would report the dark palette as
# if it were the base one.
theme_start = base_css.index("@theme")
dark_start = base_css.index('[data-theme="dark"]', theme_start)
base_css = base_css[theme_start...dark_start]
check("institute (design system)", base_css, "color-", BASE_CHECKS.map { |d, f, b, fl| [ d, f, b, fl ] }, failures)

WORLD_STYLESHEETS.each do |path|
  css = path.read
  next unless css.match?(/--w-[a-z0-9-]+:\s*oklch/)

  check(path.basename(".css").to_s, css, "w-", CHECKS, failures)
end

if failures.any?
  warn "\nFAILED:"
  failures.each { |failure| warn "  #{failure}" }
  exit 1
end

puts "\nEvery declared palette clears its floors."
