# Copy to .env and fill in. Never commit .env.
# Loaded in development and test by dotenv-rails. Production uses real secrets.

# --- Docker services -------------------------------------------------------
# Postgres is exposed on 5433, not 5432, because a native PostgreSQL cluster
# already owns 5432 on this machine.
POSTGRES_PASSWORD=wellness_toys_dev

# Meilisearch requires a master key of at least 16 bytes.
MEILISEARCH_MASTER_KEY=wellness_toys_dev_master_key_0000
MEILISEARCH_URL=http://127.0.0.1:7700

# --- Rails -----------------------------------------------------------------
DATABASE_URL=postgresql://wellness_toys:wellness_toys_dev@127.0.0.1:5433/wellness_toys_development
TEST_DATABASE_URL=postgresql://wellness_toys:wellness_toys_dev@127.0.0.1:5433/wellness_toys_test

# --- Field encryption ------------------------------------------------------
# Generate with: bin/rails db:encryption:init
# These are development placeholders. Production keys live in the deployment
# secret store, never here, and must be rotatable (see gems.md section 14).
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# --- Outbound email --------------------------------------------------------
# Leave blank in development; letter_opener handles delivery instead.
RESEND_API_KEY=

# --- Error monitoring ------------------------------------------------------
# Leave blank in development; Sentry stays disabled when unset.
SENTRY_DSN=

# --- Brand -----------------------------------------------------------------
# Overrides config/brand.yml when set.
BRAND_NAME=
