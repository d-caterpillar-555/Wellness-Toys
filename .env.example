# Copy to .env and fill in. Never commit .env.
# Loaded in development and test by dotenv-rails. Production uses real secrets.
#
# NOTE: there are deliberately no DATABASE_URL or TEST_DATABASE_URL entries.
# Rails gives DATABASE_URL precedence over config/database.yml in every
# environment it applies to, so setting it silently redirects the test suite at
# the development database. Connection details live in config/database.yml,
# which reads individual DATABASE_* variables with development defaults.
#
# Production is the exception: it takes a single DATABASE_URL from the
# deployment secret store, as configured in config/database.yml.

# --- Docker services -------------------------------------------------------
# Postgres is published on 5433 by docker-compose.yml, not 5432, because a
# native PostgreSQL cluster may already own 5432.
POSTGRES_PASSWORD=wellness_toys_dev

# Meilisearch requires a master key of at least 16 bytes.
MEILISEARCH_MASTER_KEY=wellness_toys_dev_master_key_0000
MEILISEARCH_URL=http://127.0.0.1:7700

# --- Field encryption ------------------------------------------------------
# Generate with: bin/rails db:encryption:init
# Development placeholders. Production keys live in the deployment secret store,
# never here, and must be rotatable (see gems.md section 14).
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# --- Outbound email --------------------------------------------------------
# Leave blank in development; letter_opener handles delivery instead.
RESEND_API_KEY=

# --- Error monitoring ------------------------------------------------------
# Leave blank in development; Sentry stays disabled when unset.
SENTRY_DSN=

# --- Trading identity ------------------------------------------------------
# Override config/store.yml when set.
STORE_NAME=
STORE_URL=
